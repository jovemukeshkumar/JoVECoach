{
  "rewrites": [
    {
      "source": "/pp",
      "destination": "/"
    },
    {
      "source": "/pp/",
      "destination": "/"
    },
    {
      "source": "/pp/:path*",
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*).(jpg|jpeg|png|gif|svg|webp|webm|ico|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
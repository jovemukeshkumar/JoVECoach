{
  "rewrites": [
    {
      "source": "/pp",
      "destination": "/"
    },
    {
      "source": "/pp/",
      "destination": "/"
    },
    {
      "source": "/pp/:path*",
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
    
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|gif|svg|webp|webm|ico|css|js|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
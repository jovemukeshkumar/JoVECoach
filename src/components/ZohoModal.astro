		#crmWebToEntityForm_modal {
			padding: 24px 20px !important; /* Reduced padding */
			background-position: center bottom !important;
			background-size: 80% !important;
			background-image: none !important;
		}

		.zcwf_title {
			font-size: 22px !important; /* Smaller title */
			margin-bottom: 8px !important;
		}

		.zcwf_subtitle {
			font-size: 14px !important;
			margin-bottom: 20px !important; /* Reduced margin */
		}

		.zcwf_formVisibleFields_row {
			flex-direction: column !important;
			gap: 12px !important; /* Reduced gap */
			margin-bottom: 16px !important;
		}

		.zcwf_benefits {
			margin-top: 16px;
			font-size: 11px;
		}

		.zcwf_lblLeft .zcwf_col_fld input[type="text"],
		.zcwf_lblLeft .zcwf_col_fld input[type="email"] {
			padding: 8px 12px !important; /* Reduced height (0.75x) */
			font-size: 13px !important;
		}

		.zcwf_formVisibleFields_row,
		.zcwf_formVisibleFields,
		.zcwf_col_fld {
			min-height: auto !important;
		}
	}
</style>

<script is:inline>
	// Modal Logic
	const modalOverlay = document.getElementById("zoho-modal-overlay");
	const closeBtn = document.getElementById("close-modal-btn");

	window.openZohoModal = function () {
		modalOverlay.style.display = "flex";
		document.body.style.overflow = "hidden"; // Prevent scrolling
	};

	window.closeZohoModal = function () {
		modalOverlay.style.display = "none";
		document.body.style.overflow = "auto";
	};

	if (closeBtn) {
		closeBtn.addEventListener("click", window.closeZohoModal);
	}

	if (modalOverlay) {
		modalOverlay.addEventListener("click", e => {
			if (e.target === modalOverlay) {
				window.closeZohoModal();
			}
		});
	}

	// Validation Logic (Scoped to Modal)
	window.rccallback_modal = function () {
		if (document.getElementById("recap_modal") != undefined) {
			document.getElementById("recap_modal").setAttribute("captcha-verified", true);
		}
		if (document.getElementById("recapErr_modal") != undefined && document.getElementById("recapErr_modal").style.visibility == "visible") {
			document.getElementById("recapErr_modal").style.visibility = "hidden";
		}
	};

	function reCaptchaAlert_modal() {
		var recap = document.getElementById("recap_modal");
		if (recap != undefined && recap.getAttribute("captcha-verified") == "false") {
			document.getElementById("recapErr_modal").style.visibility = "visible";
			return false;
		}
		return true;
	}

	function validateEmail_modal() {
		var form = document.getElementById("webform_modal");
		var emailFld = form.querySelectorAll("[ftype=email]");
		var i;
		for (i = 0; i < emailFld.length; i++) {
			var emailVal = emailFld[i].value;
			if (emailVal.replace(/^\s+|\s+$/g, "").length != 0) {
				var atpos = emailVal.indexOf("@");
				var dotpos = emailVal.lastIndexOf(".");
				if (atpos < 1 || dotpos < atpos + 2 || dotpos + 2 >= emailVal.length) {
					alert("Please enter a valid email address. ");
					emailFld[i].focus();
					return false;
				}
			}
		}
		return true;
	}

	window.checkMandatory_modal = function () {
		var mndFileds = new Array("Last Name", "Email");
		var fldLangVal = new Array("Name", "Email");
		for (i = 0; i < mndFileds.length; i++) {
			var fieldObj = document.forms["webform_modal"][mndFileds[i]];
			if (fieldObj) {
				if (fieldObj.value.replace(/^\s+|\s+$/g, "").length == 0) {
					alert(fldLangVal[i] + " cannot be empty.");
					fieldObj.focus();
					return false;
				}
			}
		}
		if (!validateEmail_modal()) {
			return false;
		}
		if (!reCaptchaAlert_modal()) {
			return false;
		}
		// Construct Redirect URL with Name and Email
		var nameField = document.getElementById("Last_Name_modal");
		var emailField = document.getElementById("Email_modal");
		var redirectURL = "https://coach.jove.com/signup";

		if (nameField && emailField) {
			redirectURL += "?name=" + encodeURIComponent(nameField.value) + "&email=" + encodeURIComponent(emailField.value);
		}

		// Set returnURL hidden field
		var returnURLField = document.querySelector("#webform_modal input[name='returnURL']");
		if (returnURLField) {
			returnURLField.value = redirectURL;
		}

		document.querySelector("#webform_modal .formsubmit").setAttribute("disabled", true);
		return true;
	};

	// Attach submit handler manually since we can't use inline onSubmit easily with scoped functions
	const modalForm = document.getElementById("webform_modal");
	if (modalForm) {
		modalForm.onsubmit = function () {
			document.charset = "UTF-8";
			return window.checkMandatory_modal();
		};
	}

	// UTM Population for Modal
	(function () {
		const params = new URLSearchParams(window.location.search);
		const mapping = {
			utm_source: "CONTACTCF20_modal",
			utm_medium: "CONTACTCF19_modal",
			utm_campaign: "CONTACTCF17_modal",
			utm_term: "CONTACTCF21_modal",
			utm_content: "CONTACTCF18_modal",
			ad_id: "CONTACTCF4_modal",
			ad_group_id: "CONTACTCF2_modal",
			ad_group_name: "CONTACTCF3_modal",
			ad_campaign_id: "CONTACTCF1_modal",
			ad_name: "CONTACTCF5_modal",
			ad_platform: "CONTACTCF6_modal",
			landing_page_url: "CONTACTCF11_modal",
			referrer_url: "CONTACTCF14_modal",
		};

		for (const key in mapping) {
			const fieldId = mapping[key];
			const el = document.getElementById(fieldId);
			if (!el) continue;
			if (params.has(key)) {
				el.value = params.get(key);
			}
		}

		const landingField = document.getElementById("CONTACTCF11_modal");
		if (landingField) landingField.value = window.location.href;

		const refField = document.getElementById("CONTACTCF14_modal");
		if (refField) refField.value = document.referrer || "-";
	})();
</script>

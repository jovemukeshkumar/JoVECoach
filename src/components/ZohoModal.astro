<style>
	.modal-overlay {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(0, 0, 0, 0.5);
		backdrop-filter: blur(5px);
		z-index: 9999;
		display: flex;
		justify-content: center;
		align-items: center;
		padding: 20px;
	}

	.modal-container {
		position: relative;
		width: 100%;
		max-width: 600px;
		max-height: 90vh;
		overflow-y: auto;
		border-radius: 15px;
	}

	.close-btn {
		position: absolute;
		top: 10px;
		right: 15px;
		font-size: 30px;
		color: white;
		background: transparent;
		border: none;
		cursor: pointer;
		z-index: 10000;
	}

	/* Reuse existing Zoho styles but ensure they apply */
	.zcwf_lblLeft .zcwf_title {
		color: #fff !important;
		font-family: Inter !important;
		font-size: 36px !important;
		font-weight: 500 !important;
		margin-bottom: 12px;
		margin-top: 20px;
		max-width: 75%;
	}

	.zcwf_subtitle {
		color: rgba(255, 255, 255, 0.9) !important;
		font-family: Inter !important;
		font-size: 16px !important;
		margin-bottom: 32px;
	}

	/* Ensure modal form looks like the original */
	#crmWebToEntityForm_modal {
		background: #0085f6 !important;
		/* Removed cardBg.svg to allow new background image to show */
		padding: 40px 50px 20px 50px !important;
		border-radius: 15px !important;
		position: relative;
		z-index: 1;
		overflow: hidden;
	}

	#Last_Name_modal,
	#Email_modal {
		min-height: auto !important;
		width: 100% !important;
		padding: 12px 10px !important;
		border-radius: 5px !important;
	}

	/* Ensure content sits above the background image */
	#crmWebToEntityForm_modal > form {
		position: relative;
		z-index: 1;
	}

	/* Form Layout Styles */
	.zcwf_row {
		display: flex;
		margin-bottom: 20px;
	}

	.zcwf_col_fld {
		flex: 1;
	}

	.zcwf_formVisibleFields_row {
		display: flex !important;
		flex-direction: column !important; /* Stack vertically */
		gap: 1.5rem !important; /* Increased gap */
		margin-bottom: 20px !important;
	}

	.zcwf_formVisibleFields_row .zcwf_col_fld {
		width: 100% !important; /* Full width */
		padding: 0 !important;
		margin: 0 !important;
	}

	.zcwf_lblLeft .zcwf_col_fld input[type="text"],
	.zcwf_lblLeft .zcwf_col_fld input[type="email"] {
		width: 100%;
		border: 1px solid rgba(255, 255, 255, 0.3) !important;
		border-radius: 8px;
		padding: 8px 12px !important; /* Reduced height (0.75x) */
		background-color: rgba(255, 255, 255, 0.95) !important;
		color: #333 !important;
		font-size: 14px !important;
		font-family: Inter !important;
	}

	.zcwf_lblLeft .zcwf_col_fld input::placeholder {
		color: #c8c1c1;
	}

	.zcwf_lblLeft .zcwf_col_lab {
		display: none;
	}

	.wfrm_fld_dpNn {
		display: none;
	}

	.zcwf_benefits {
		font-size: 12px;
		color: rgba(255, 255, 255, 0.6);
		margin-top: 20px;
		font-family: Inter;
		text-align: left; /* Left align */
	}

	.formsubmit.zcwf_button {
		width: 100%;
		background: transparent !important;
		color: white !important;
		border: 1px solid rgba(255, 255, 255, 0.4) !important;
		padding: 12px 28px !important;
		font-size: 18px !important;
		border-radius: 50px !important;
		cursor: pointer;
		transition: all 0.25s ease;
	}

	.formsubmit.zcwf_button:hover {
		background: rgba(255, 255, 255, 0.15) !important;
	}

	/* Background Image via Pseudo-element */
	#crmWebToEntityForm_modal::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 0; /* Changed from -1 to 0 to sit above background color but below content */
		background-image: url("/secondCTAbg.png");
		background-size: 95%;
		background-position: 1480% 100%;
		background-repeat: no-repeat;
		opacity: 0.5;
		pointer-events: none;
	}

	@media (max-width: 768px) {
		.modal-overlay {
			padding: 0;
		}

		.modal-container {
			width: 90%; /* Prevent touching edges */
			max-height: 85vh; /* Ensure it fits vertically */
			margin: auto; /* Robust centering */

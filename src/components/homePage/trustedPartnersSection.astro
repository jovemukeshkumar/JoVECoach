---
import qs from "qs";

const homePageQuery = qs.stringify(
  {
    populate: {
      trustedPartners: {
        populate: "*",
      },
    },
  },
  { encodeValuesOnly: true },
);


async function getStrapiData(path: string) {
  try {
    const BASE_URL = import.meta.env.PUBLIC_BACKEND_URL;
    if (!BASE_URL) {
      console.error("❌ Missing PUBLIC_BACKEND_URL");
      return null;
    }

    const url = new URL(path, BASE_URL);
    url.search = homePageQuery;

    const res = await fetch(url.href);

    if (!res.ok) {
      console.error("❌ Strapi request failed:", res.status);
      return null;
    }

    const json = await res.json();
    return json?.data ?? null;
  } catch (error) {
    console.error("❌ Strapi fetch error:", error);
    return null;
  }
}

const data = await getStrapiData("/api/home-page");


const trustedPartners =
  data?.trustedPartners?.find((b: any) => b.__component === "layout.section7") ??
  { trustedPartnersHeading: "", trustedPartnersLogoImage: [] };
---

<style>

.section7-container {
    background-color: #252a2e;
    color: white;
    text-align: center;
    padding: 81px 0;
    font-family: Inter, sans-serif;
}


.section7-heading-wrapper {
    width: 100%;
    max-width: 720px;
    margin: 0 auto 73px;
}

.section7-heading {
    font-size: 24px;
    font-weight: 400;
    color: white;
    line-height: 140%;
}

.section7-slider-wrapper {
    position: relative;
    overflow: hidden;
    max-width: max-content;
    margin: 40px auto 0;
    padding: 0 49px;
}

.section7-slider {
    overflow-x: auto;
    white-space: nowrap;
    display: flex;
    gap: 64px;
    align-items: center;
    scroll-behavior: smooth;
}

.section7-logo {
    height: auto;
    max-height: 55px;
    object-fit: contain;
}

/* ----------------------------
      RESPONSIVE DESIGN
----------------------------- */

/* Tablets */
@media (max-width: 900px) {
    .section7-heading {
        font-size: 22px;
    }

    .section7-slider {
        gap: 48px;
    }
}

/* Mobile */
@media (max-width: 600px) {
    .section7-container {
        padding: 60px 0;
    }

    .section7-heading-wrapper {
        margin-bottom: 48px;
        /* padding: 0 20px; */
    }

    .section7-heading {
        font-size: 18px;
    }

    .section7-slider-wrapper {
        padding: 0 20px;
    }

    .section7-slider {
        gap: 36px;
    }

    .section7-logo {
        max-height: 45px;
    }
}

/* Small Mobile */
@media (max-width: 400px) {
    .section7-heading {
        font-size: 16px;
    }

    .section7-slider {
        gap: 28px;
    }

    .section7-logo {
        max-height: 40px;
    }
}
</style>


<section class="section7">
  <div class="section7-container">
    <div class="section7-heading-wrapper">
      <div class="section7-heading">
        {trustedPartners.trustedPartnersHeading || "Our Trusted Partners"}
      </div>
    </div>

    <div class="section7-slider-wrapper">
      <div class="section7-slider">
        {
          (trustedPartners.trustedPartnersLogoImage ?? []).map((img: any) => {
            const imgUrl = img?.url ?? "/fallback-logo.png"; // fallback
            const imgAlt = img?.name ?? "Partner Logo";

            return (
              <img src={imgUrl} alt={imgAlt} class="section7-logo" loading="lazy" />
            );
          })
        }
      </div>
    </div>
  </div>
</section>


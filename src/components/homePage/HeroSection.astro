---
import qs from "qs";
import HeroSectionImage from "../../assets/Hero-Section-Mobile_img.webp";
import { Image } from "astro:assets";

const homePageQuery = qs.stringify(
	{
		populate: {
			HeroSection: {
				on: {
					"layout.hero-section": {
						populate: {
							video: true,
							image: true,
							link: true,
							pointsSlider: {
								populate: "*",
							},
						},
					},
				},
			},
		},
	},
	{ encodeValuesOnly: true },
);

async function getStrapiData(path: string) {
	try {
		const BASE_URL = import.meta.env.PUBLIC_BACKEND_URL;
		if (!BASE_URL) {
			console.error("❌ Missing PUBLIC_BACKEND_URL");
			return null;
		}

		const url = new URL(path, BASE_URL);
		url.search = homePageQuery;

		const res = await fetch(url.toString());
		if (!res.ok) {
			console.error("❌ Strapi Fetch Failed:", res.status);
			return null;
		}

		const json = await res.json();
		return json?.data ?? null;
	} catch (err) {
		console.error("❌ Error fetching Strapi:", err);
		return null;
	}
}

const data = await getStrapiData("/api/home-page");

const heroSection = Array.isArray(data?.HeroSection) ? data.HeroSection : [];
---

<style>
	.hero-section {
		background-image: url("../../assets/heroSectionbg.png");
		background-size: cover;
		background-position: center;
		padding: 60px 20px 0px 20px;
	}

	.hero-container {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 60px;
		align-items: center;
		max-width: 1320px;
		margin: 0 auto;
		padding: 0 20px;
	}

	.hero-content {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		padding: 20px;
	}

	.hero-title {
		font-family: Inter, sans-serif;
		font-weight: 700;
		font-size: 55px;
		line-height: 1.2;
		letter-spacing: 0%;
		color: #111827;
		max-width: 450px;
		margin: 0 0 20px 0;
	}

	.hero-subtitle {
		font-family: Inter, sans-serif;
		font-weight: 400;
		font-size: clamp(16px, 2vw, 18px);
		line-height: 1.4;
		letter-spacing: -1%;
		max-width: 400px;
		margin: 0 0 40px 0;
		color: #4b5563;
	}

	.cta-button {
		background: #4284e5;
		color: white;
		font-family: Inter, sans-serif;
		font-weight: 600;
		font-size: clamp(16px, 2vw, 18px);
		line-height: 28px;
		letter-spacing: 0%;
		text-align: center;
		padding: 16px 40px;
		border: none;
		border-radius: 75px;
		cursor: pointer;
		transition: all 0.3s ease;
		display: inline-block;
		white-space: nowrap;
	}

	.cta-button:hover {
		transform: translateY(-2px);
		box-shadow: 0 15px 40px rgba(76, 139, 255, 0.4);
	}

	.no-credit {
		font-family: Inter, sans-serif;
		font-weight: 400;
		font-size: 12px;
		line-height: 20px;
		letter-spacing: 0%;
		color: #6b7280;
		margin: 10px 0px 10px 20px;
		display: block;
	}

	.hero-image {
		position: relative;
		width: 100%;
		display: flex;
		justify-content: center;
		align-items: center;
		min-width: 770px;
	}

	.hero-mobile-img {
		display: none;
	}

	.hero-video {
		width: 100%;
		height: auto;
		border-radius: 30px;
		display: block;
		object-fit: contain;
		max-width: 100%;
	}

	.stats-bar {
		background: linear-gradient(180deg, #dae9f5 0%, #c8dff2 100%);
		padding: 30px 20px;
		overflow: hidden;
	}

	.stats-slider {
		display: flex;
		gap: 40px;
		width: max-content;
		animation: slide 40s linear infinite;
	}

	.stat-item {
		display: flex;
		align-items: center;
		gap: 15px;
		min-width: 320px;
		white-space: nowrap;
	}

	@keyframes slide {
		0% {
			transform: translateX(0);
		}
		100% {
			transform: translateX(-50%);
		}
	}

	.check-icon {
		width: 40px;
		height: 40px;
		background: #4c8bff;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		color: white;
		font-size: 20px;
		font-weight: bold;
		flex-shrink: 0;
	}

	.stat-text {
		font-size: clamp(16px, 2vw, 20px);
		font-weight: 600;
		color: #1a1a1a;
		font-family: Inter, sans-serif;
	}

	/* Tablet */
	@media (max-width: 1024px) {
		.hero-container {
			gap: 40px;
			grid-template-columns: 1fr;

			padding: 0 15px;
		}
		.hero-image {
			min-width: 670px;
			/* order: -1; */
		}
		.hero-video {
			max-width: 700px;
			/* order: -1; */
		}
		.hero-content {
			align-items: center;
			padding: 10px;
		}

		.hero-title {
			text-align: center;
		}
		.hero-subtitle {
			text-align: center;
		}
		.no-credit {
			text-align: center;
			margin-left: 0;
		}

		.stat-item {
			min-width: 280px;
		}
	}

	/* Mobile */
	@media (max-width: 768px) {
		.hero-section {
			padding: 40px 15px;
		}

		.hero-container {
			grid-template-columns: 1fr;
			gap: 30px;
			padding: 0 10px;
		}

		.hero-content {
			align-items: center;
			text-align: center;
			padding: 0;
		}

		.hero-title {
			font-size: 40px;
			text-align: center;
		}

		.hero-subtitle {
			text-align: center;
			margin-bottom: 30px;
		}

		.hero-subtitle br {
			display: none;
		}

		.cta-button {
			width: 100%;
			max-width: 350px;
			padding: 18px 30px;
		}

		.no-credit {
			text-align: center;
		}

		.hero-image {
			min-width: 300px;
			/* order: -1; */
		}

		.hero-video {
			border-radius: 20px;
		}

		.stats-bar {
			padding: 25px 15px;
		}

		.stat-item {
			min-width: 260px;
			gap: 12px;
		}

		.check-icon {
			width: 36px;
			height: 36px;
			font-size: 18px;
		}
		.hero-video {
			display: none;
		}
		.hero-mobile-img {
			display: block;
			max-width: 500px;
			height: auto;
		}
	}

	/* Small Mobile */
	@media (max-width: 480px) {
		.hero-section {
			padding: 30px 10px;
		}

		.hero-container {
			gap: 20px;
		}

		.hero-title {
			font-size: 32px;
			margin-bottom: 15px;
		}

		.hero-subtitle {
			margin-bottom: 25px;
		}

		.cta-button {
			padding: 16px 25px;
			font-size: 15px;
		}

		.no-credit {
			font-size: 11px;
		}

		.hero-video {
			border-radius: 15px;
		}

		.stats-bar {
			padding: 20px 10px;
		}

		.stat-item {
			min-width: 240px;
			gap: 10px;
		}

		.check-icon {
			width: 32px;
			height: 32px;
			font-size: 16px;
		}
		.hero-mobile-img {
			display: block;
			max-width: 300px;
			height: auto;
		}
	}

	/* Extra Small Mobile */
	@media (max-width: 360px) {
		.hero-title {
			font-size: 28px;
		}

		.cta-button {
			font-size: 14px;
			padding: 14px 20px;
		}

		.stat-item {
			min-width: 220px;
		}
	}
</style>

{
	heroSection.map((hero: any) => {
		const heading = hero?.heading ?? "Welcome!";
		const subHeading = hero?.subHeading ?? "";
		const notes = hero?.notes ?? "";
		const linkText = hero?.link?.text ?? "Learn More";
		const linkURL = hero?.link?.url ?? "#";

		const image = hero?.image?.formats?.large;
		const imageUrl = image?.url ?? HeroSectionImage;
		const imageWidth = image?.width ?? 500;
		const imageHeight = image?.height ?? 350;

		const videoUrl = hero?.video?.url ?? null;

		return (
			<section class="hero-section">
				<div class="hero-container">
					<div class="hero-content">
						<h1 class="hero-title">{heading}</h1>
						<p class="hero-subtitle">{subHeading}</p>

						<a href={linkURL}>
							<button class="cta-button">{linkText}</button>
						</a>

						{notes && <span class="no-credit">{notes}</span>}
					</div>

					<div class="hero-image">
						{videoUrl && (
							<video autoplay loop muted playsinline class="hero-video">
								<source src={videoUrl} type="video/webm" media="(min-width: 769px)" />
							</video>
						)}

						<Image src={imageUrl} alt="Hero Image" class="hero-mobile-img" width={imageWidth} height={imageHeight} />
					</div>
				</div>
			</section>
		);
	})
}

<div class="stats-bar">
	<div class="stats-slider">
		{
			heroSection.flatMap((hero: any) => {
				const slider = hero?.pointsSlider;
				const iconUrl = slider?.icon?.url ?? "/fallback-icon.png";

				return (slider?.points ?? []).map((point: any) => (
					<div class="stat-item">
						<img src={iconUrl} alt="Slider Icon" class="check-icon" />
						<div class="stat-text">{point?.point ?? ""}</div>
					</div>
				));
			})
		}

		<!-- Duplicate for animation -->
		{
			heroSection.flatMap((hero: any) => {
				const slider = hero?.pointsSlider;
				const iconUrl = slider?.icon?.url ?? "/fallback-icon.png";

				return (slider?.points ?? []).map((point: any) => (
					<div class="stat-item">
						<img src={iconUrl} alt="Slider Icon" class="check-icon" />
						<div class="stat-text">{point?.point ?? ""}</div>
					</div>
				));
			})
		}
	</div>
</div>

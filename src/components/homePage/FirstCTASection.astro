---
import { Image } from 'astro:assets'
import aiChatIcon from '../../assets/ai-chat-icon.svg'
---

<style>
.ai-cta-section {
  padding: 4rem 1rem;
  margin-bottom: -100px;
  position: relative;
  z-index: 10;
}

.ai-cta-card {
  max-width: 1200px;
  max-height: 280px;
  margin: 0 auto;
  background: #F8F7F4; /* solid base */
  border-radius: 20px;
  padding: 0 4rem;
  display: grid;
  grid-template-columns: 1.2fr 0.6fr 1fr;
  align-items: center;
  gap: 2rem;
  position: relative;
  z-index: 10;
  box-shadow: 0px 10px 40px rgba(0, 0, 0, 0.25);
  overflow: hidden; /* clip pseudo-element */
}
.ai-cta-card::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 0;

  background-image: url("../../assets/aiChatBg.png");
  background-size: contain;
  background-position: right center;
  background-repeat: no-repeat;

  pointer-events: none;
}
.ai-cta-card > * {
  position: relative;
  z-index: 1;
}


.ai-cta-content{
    max-width: 445px;
}
/* Left text */
.ai-cta-content h3 {
    font-family: Inter;
    font-weight: 500;
    font-size: 30px;
    line-height: 120%;
    letter-spacing: 0%;
    color: #000;
    margin: 0;
}

.ai-cta-content p {
    font-family: Inter;
    font-weight: 500;
    font-size: 18px;
    line-height: 140%;
    letter-spacing: 0%;
    color:#000;
}

.ai-cta-btn {
  background: #2183ed;
  color: #fff;
  border: none;
  padding: 12px 26px;
  border-radius: 30px;
  font-size: 18px;
  font-weight: 500;
  line-height: 28px;
  letter-spacing: 0%;
  cursor: pointer;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.ai-cta-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(33, 131, 237, 0.35);
}

/* Center icon */
.ai-cta-icon {
  display: flex;
  justify-content: start;
}

.ai-cta-icon img {
    width: 100%;
  height: auto;
}

/* Right form */
.ai-cta-form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  max-width: 325px;
}

.ai-cta-form input {
  width: 100%;
  padding: 14px 16px;
  border-radius: 10px;
border: 2px solid #EEEEEE;
  font-size: 15px;
  outline: none;
  font-family: Inter;
font-weight: 400;
font-size: 16px;
line-height: 140%;
letter-spacing: 0%;
}

.ai-cta-form input:focus {
  border-color: #2183ed;
}

/* ---------- Responsive ---------- */

@media (max-width: 992px) {
  .ai-cta-card {
    grid-template-columns: 1fr;
    text-align: center;
    padding: 2.5rem 2rem;
  }

  .ai-cta-icon {
    order: -1;
  }

  .ai-cta-form {
    width: 100%;
  }
}

@media (max-width: 480px) {
  .ai-cta-content h3 {
    font-size: 22px;
  }

  .ai-cta-btn {
    width: 100%;
  }
}

</style>
<section class="ai-cta-section">
  <div class="ai-cta-card">
    <!-- Left content -->
    <div class="ai-cta-content">
      <h3>Stuck on a concept right now?</h3>
      <p>See how JoVE Coach explains it clearly — with AI.</p>
      <button class="ai-cta-btn">Try an AI Explanation</button>
    </div>

    <!-- Center icon -->
    <div class="ai-cta-icon">
      <Image src={aiChatIcon} alt="AI Chat Icon" />
    </div>

    <!-- Right form -->
    <form class="ai-cta-form">
      <input type="text" placeholder="Name*" required />
      <input type="email" placeholder="Email*" required />
    </form>
  </div>
</section>

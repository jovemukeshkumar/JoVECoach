---
import qs from "qs";
import NavLogo from '../assets/NavLogo.svg'
const homePageQuery = qs.stringify(
	{
		populate: {
			header: {
				populate: "*",
			},
		},
	}
, { encodeValuesOnly: true });

async function getStrapiData(path: string) {
  const BASE_URL = import.meta.env.PUBLIC_BACKEND_URL;
  const url = new URL(path, BASE_URL);
  url.search = homePageQuery;

  try {
    const res = await fetch(url.href);
    const json = await res.json();
    return json.data;
  } catch (error) {
    console.error("Strapi fetch error:", error);
  }
}

const data = await getStrapiData("/api/global");

const header = data?.header;
---

<style>
	#container {
		font-family: Inter, sans-serif;
		height: 100%;
		position: sticky;
		top: 0;
		z-index: 1000;
		background-color: #fff;
		transition: all 0.35s ease-in-out;
	}

	/* Navbar */
	#navbar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 30px 100px;
		max-width: 1320px;
		margin: 0 auto;
		transition: all 0.35s ease-in-out;
	}

	#logo {
		text-decoration: none;
		display: flex;
		align-items: center;
	}

	#logo img {
		width: 210px;
		max-width: 100%;
		height: auto;
		transition: all 0.35s ease-in-out;
	}

	#nav-links {
		display: flex;
		gap: 20px;
		align-items: center;
	}

	#nav-links a {
		text-decoration: none;
		color: #fff;
		font-size: 16px;
		font-weight: 500;
		transition: color 0.3s ease;
		white-space: nowrap;
	}

	#nav-links a:hover {
		color: #fff;
	}

	#nav-ctas {
		display: flex;
		align-items: center;
	}

	.btn-free-trial a {
		text-decoration: none;
		color: #4284E5;
		font-size: 16px;
		font-weight: 500;
		transition: color 0.3s ease;
	}

	#nav-ctas a:hover {
		color: #fff;
	}

	.btn-free-trial {
		background: #ffffff;
		border-radius: 100px;
		margin-left: 8px;
		color: #4284E5;
		border: 1px #4284E5 solid;
		font-family: Inter, sans-serif;
		font-weight: 500;
		font-size: 12.64px;
		line-height: 100%;
		letter-spacing: -0.13px;
		text-align: center;
		text-transform: capitalize;
		padding: 14px 15px;
		cursor: pointer;
		transition: all 0.3s ease;
	}

	.btn-free-trial:hover {
		background-color: #4284E5;
		color: #fff;
	}

	.btn-free-trial:hover a {
		color: #ffffff;
	}

	/* Sticky header styles */
	.stickyHeader {
		background: #ffffff !important;
		box-shadow: 0px 1px 11px -1px rgba(214, 214, 214, 1);
	}

	#navbar.shrink {
		padding: 15px 100px !important;
	}

	.stickyHeader #logo img {
		width: 140px !important;
	}

	/* Tablet */
	@media screen and (max-width: 1024px) {
		#navbar {
			padding: 25px 50px;
		}

		#navbar.shrink {
			padding: 12px 50px !important;
		}

		#logo img {
			width: 180px;
		}

		.stickyHeader #logo img {
			width: 120px !important;
		}

		#nav-links {
			gap: 15px;
		}

		#nav-links a {
			font-size: 15px;
		}

		.btn-free-trial {
			font-size: 12px;
			padding: 12px 14px;
		}
	}

	/* Mobile */
	@media screen and (max-width: 768px) {
		#navbar {
			padding: 20px 20px;
			flex-wrap: wrap;
		}

		#navbar.shrink {
			padding: 12px 20px !important;
		}

		#logo {
			flex: 0 0 auto;
		}

		#logo img {
			width: 150px;
		}

		.stickyHeader #logo img {
			width: 110px !important;
		}

		#nav-links {
			display: none;
		}

		#nav-ctas {
			flex: 0 0 auto;
		}

		#nav-ctas a {
			font-size: 13px;
		}

		.btn-free-trial {
			padding: 10px 18px;
			margin-left: 0;
		}
	}

	/* Small Mobile */
	@media screen and (max-width: 480px) {
		#navbar {
			padding: 30px 25px;
		}

		#navbar.shrink {
			padding: 10px 15px !important;
		}

		#logo img {
			width: 130px;
		}

		.stickyHeader #logo img {
			width: 100px !important;
		}

		#nav-ctas a {
			font-size: 10px;
		}

		.btn-free-trial {
			padding: 10px 15px;
			font-size: 11px;
		}
	}

	/* Extra Small Mobile */
	@media screen and (max-width: 360px) {
		#navbar {
			padding: 22px 11px;
		}

		#logo img {
			width: 110px;
		}

		.stickyHeader #logo img {
			width: 85px !important;
		}

		.btn-free-trial {
			padding: 8px 12px;
			font-size: 10px;
		}
	}
</style>

<nav id="container">
	<div id="navbar">
		<a href={header?.logoImageUrl?.url || "/"} id="logo">
			{header?.logoImage && (
				<img
					src={`${import.meta.env.PUBLIC_BACKEND_URL}${header.logoImage.url}`}
					alt={header.logoImage.alternativeText || "Logo"}
					width="210"
					height="auto"
				/>
			)}
		</a>

		<!-- Navigation Links (hidden on mobile) -->
		<!-- <div id="nav-links">
			<a href={header?.microCourses?.url}>{header?.microCourses?.text || 'NavLink'}</a>
			<a href={header?.about?.url}>{header?.about?.text || 'NavLink'}</a>
			<a href={header?.pricing?.url}>{header?.pricing?.text || 'NavLink'}</a>
		</div> -->
		
		<!-- Free Trial Button -->
		<div id="nav-ctas">
			<button class="btn-free-trial">
				<a href="#crmWebToEntityForm">
					{header?.freeTrialButton?.text || "Start Free Trial"}
				</a>
			</button>
		</div>
	</div>
</nav>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		const header = document.querySelector("#container") as HTMLElement | null;
		const navbar = document.querySelector("#navbar") as HTMLElement | null;
		const logoImg = document.querySelector("#logo img") as HTMLImageElement | null;

		if (!header || !navbar || !logoImg) return;

		window.addEventListener("scroll", () => {
			if (window.scrollY > 50) {
				header.classList.add("stickyHeader");
				navbar.classList.add("shrink");
			} else {
				header.classList.remove("stickyHeader");
				navbar.classList.remove("shrink");
			}
		});
	});
</script>
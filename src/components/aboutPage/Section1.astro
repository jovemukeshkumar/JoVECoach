---
import { Image } from "astro:assets";
import aboutPageIcon1 from "../../assets/aboutPageIcon1.svg";
import aboutPageIcon2 from "../../assets/aboutPageIcon2.svg";
import aboutPageIcon3 from "../../assets/aboutPageIcon3.svg";
import aboutPageIcon4 from "../../assets/aboutPageIcon4.svg";
---

<div style="width: 100%; background: transparent; padding: 147px 0px 139px; text-align: center;">
	<p style="width: 100%; color: rgb(0, 0, 0); text-align: center;  font-size: 46px; font-style: normal; font-weight: 600; line-height: 120%; letter-spacing: -0.46px; margin-bottom: 28px;">
		The World’s Most Trusted <br /> Visual Learning Platform
	</p><p style="color: rgb(63, 63, 63); text-align: center;  font-size: 18px; font-style: normal; font-weight: 400; line-height: 150%; margin-bottom: 86px;">
		Trusted by over 1 million learners across 1,800+ institutes - proving<br />that <span style="color: rgb(33, 131, 237);  font-size: 18px; font-style: normal; font-weight: 500; line-height: 150%;">seeing truly is believing.</span>
	</p><div style="width: 100%; display: flex; justify-content: center; align-items: center; margin-bottom: 0px;">
		<div style="width: 100%; max-width: 1053px; min-width: 1053px; display: flex; justify-content: space-between; margin: 0px auto; gap: 64px;">
			<div style="display: flex; flex-direction: row; align-items: center; justify-content: end; width: 214px; height: 70px;">
				<Image alt="Star Icon" src={aboutPageIcon1} style="margin-right: 24px;" />
				<div style="width: 100%; display: flex; flex-direction: column; justify-content: start; align-items: center; text-align: left;">
					<p style="text-wrap: nowrap; margin: 10px; text-align: left; color: rgb(0, 0, 0);  font-size: 32px; font-style: normal; font-weight: 500; line-height: 130%;"> 1 Million+ </p><p
						style="margin: 0px; color: rgb(0, 0, 0);  font-size: 14px; font-style: normal; font-weight: 400; line-height: 130%; text-align: left;"
					>
						learners trust us
					</p>
				</div>
			</div><div style="display: flex; flex-direction: row; align-items: center; justify-content: end; width: 214px; height: 70px;">
				<Image alt="Computer Icon" src={aboutPageIcon2} style="margin-right: 24px;" /><div style="width: 100%; display: flex; flex-direction: column; justify-content: start; align-items: start; text-align: left;">
					<p style="text-wrap: nowrap; margin: 10px; text-align: left; color: rgb(0, 0, 0);  font-size: 32px; font-style: normal; font-weight: 500; line-height: 130%;"> 500+ </p><p
						style="margin: 0px; color: rgb(0, 0, 0);  font-size: 14px; font-style: normal; font-weight: 400; line-height: 130%; text-align: left;"
					>
						Micro-courses
					</p>
				</div>
			</div><div style="display: flex; flex-direction: row; align-items: center; justify-content: end; width: 214px; height: 70px;">
				<Image alt="Tick Icon" src={aboutPageIcon3} style="margin-right: 24px;" /><div style="width: 100%; display: flex; flex-direction: column; justify-content: start; align-items: start; text-align: left;">
					<p style="text-wrap: nowrap; margin: 10px; text-align: left; color: rgb(0, 0, 0);  font-size: 32px; font-style: normal; font-weight: 500; line-height: 130%;"> 6,500+ </p><p
						style="margin: 0px; color: rgb(0, 0, 0);  font-size: 14px; font-style: normal; font-weight: 400; line-height: 130%; text-align: left;"
					>
						expert-made videos
					</p>
				</div>
			</div><div style="display: flex; flex-direction: row; align-items: center; justify-content: end; width: 214px; height: 70px;">
				<Image alt="Tick Icon" src={aboutPageIcon4} style="margin-right: 24px;" /><div style="width: 100%; display: flex; flex-direction: column; justify-content: start; align-items: start; text-align: left;">
					<p style="text-wrap: nowrap; margin: 10px; text-align: left; color: rgb(0, 0, 0);  font-size: 32px; font-style: normal; font-weight: 500; line-height: 130%;"> 19+ years </p><p
						style="margin: 0px; color: rgb(0, 0, 0);  font-size: 14px; font-style: normal; font-weight: 400; line-height: 130%; text-align: left;"
					>
						pioneering education
					</p>
				</div>
			</div>
		</div>
	</div>
</div>

<section class="container" id="hubform">
  <!-- HubSpot form container -->
<div id="hubspot-form"
    class="hs-form-html form-wrapper"
    data-region="na2"
    data-form-id="3b8ef989-448a-4862-a3fd-d838d6a48660"
    data-portal-id="244455004"
  >
  </div>
</section>


<style>
  .container {
    max-width: 1000px;
    margin: 0 auto;
  }

    .container {
      max-width: 790px;
      margin: 60px auto;
    }

    .form-wrapper {
      background: aliceblue;
      backdrop-filter: blur(10px);
      border-radius: 25px;
      padding: 10px 120px;
    }

    @media (max-width: 768px) {
      .form-wrapper {
        padding: 30px 25px;
      }
    }
  </style>
<script>
  document.addEventListener("DOMContentLoaded", () => {
  const interval = setInterval(() => {
    const btnRow = document.querySelector(".hsfc-NavigationRow__Buttons") as HTMLElement;
    if (btnRow) {
      clearInterval(interval);
      btnRow.style.justifyContent = "flex-start";
    }
  }, 100);
});

</script>
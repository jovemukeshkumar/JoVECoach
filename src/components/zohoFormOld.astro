		<script>
			function addAriaSelected1127844000000480553(event: Event) {
				const optionElem = event.target as HTMLSelectElement | null;
				if (!optionElem) return;

				const previousSelectedOption = optionElem.querySelector('[aria-selected="true"]') as HTMLOptionElement | null;
				if (previousSelectedOption) {
					previousSelectedOption.removeAttribute('aria-selected');
				}

				const options = optionElem.querySelectorAll('option');
				const selectedOption = options[optionElem.selectedIndex] as HTMLOptionElement | undefined;
				if (selectedOption) {
					selectedOption.setAttribute('aria-selected', 'true');
				}
			}

			function validateEmail1127844000000480553(): boolean {
				const form = document.forms.namedItem('WebToContacts1127844000000480553') as HTMLFormElement | null;
				if (!form) {
					return true;
				}
				// const emailFld = form.querySelectorAll<HTMLInputElement>('[ftype=email]');
        const emailFld = form.querySelectorAll<HTMLInputElement>('[data-ftype=email]');
				for (let i = 0; i < emailFld.length; i++) {
					const emailVal = emailFld[i].value;
					if (emailVal.replace(/^\s+|\s+$/g, '').length !== 0) {
						const atpos = emailVal.indexOf('@');
						const dotpos = emailVal.lastIndexOf('.');
						if (atpos < 1 || dotpos < atpos + 2 || dotpos + 2 >= emailVal.length) {
							alert('Please enter a valid email address. ');
							emailFld[i].focus();
							return false;
						}
					}
				}
				return true;
			}

			function checkMandatory1127844000000480553(): boolean {
				const mndFileds = ['Last Name', 'Email'];
				const fldLangVal = ['Name', 'Email'];

				const form = document.forms.namedItem('WebToContacts1127844000000480553') as HTMLFormElement | null;
				if (!form) {
					return true;
				}

				const formAny = form as any;

				for (let i = 0; i < mndFileds.length; i++) {
					const fieldName = mndFileds[i];
					const fieldObj = formAny[fieldName];
					if (fieldObj) {
						if ((fieldObj.value as string).replace(/^\s+|\s+$/g, '').length === 0) {
							if (fieldObj.type === 'file') {
								alert('Please select a file to upload.');
								fieldObj.focus();
								return false;
							}
							alert(fldLangVal[i] + ' cannot be empty.');
							fieldObj.focus();
							return false;
						} else if (fieldObj.nodeName === 'SELECT') {
							if (fieldObj.options[fieldObj.selectedIndex].value === '-None-') {
								alert(fldLangVal[i] + ' cannot be none.');
								fieldObj.focus();
								return false;
							}
						} else if (fieldObj.type === 'checkbox') {
							if (fieldObj.checked === false) {
								alert('Please accept  ' + fldLangVal[i]);
								fieldObj.focus();
								return false;
							}
						}
						try {
							if (fieldObj.name === 'Last Name') {
								// just store locally instead of assigning to global "name"
								const contactName = fieldObj.value;
								void contactName;
							}
						} catch (e) { }
					}
				}

				if (!validateEmail1127844000000480553()) {
					return false;
				}

				const urlparams = new URLSearchParams(window.location.search);
				if (urlparams.has('service') && urlparams.get('service') === 'smarturl') {
					const webform = document.getElementById('webform1127844000000480553') as HTMLFormElement | null;
					const service = urlparams.get('service');
					if (webform && service) {
						const smarturlfield = document.createElement('input');
						smarturlfield.setAttribute('type', 'hidden');
						smarturlfield.setAttribute('value', service);
						smarturlfield.setAttribute('name', 'service');
						webform.appendChild(smarturlfield);
					}
				}

				const submitButton = document.querySelector('.crmWebToEntityForm .formsubmit') as HTMLInputElement | HTMLButtonElement | null;
				if (submitButton) {
					submitButton.disabled = true;
				}

				return true;
			}

			function tooltipShow1127844000000480553(el: HTMLElement) {
				const tooltip = el.nextElementSibling as HTMLElement | null;
				if (!tooltip) return;

				const tooltipDisplay = tooltip.style.display;
				const allTooltip = document.getElementsByClassName('zcwf_tooltip_over') as HTMLCollectionOf<HTMLElement>;

				if (tooltipDisplay === 'none' || tooltipDisplay === '') {
					for (let i = 0; i < allTooltip.length; i++) {
						allTooltip[i].style.display = 'none';
					}
					tooltip.style.display = 'block';
				} else {
					tooltip.style.display = 'none';
				}
			}
		</script>

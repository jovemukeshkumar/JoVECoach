<style>
	.modal-overlay {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(0, 0, 0, 0.5);
		backdrop-filter: blur(5px);
		z-index: 9999;
		display: flex;
		justify-content: center;
		align-items: center;
		padding: 20px;
	}

	.modal-container {
		position: relative;
		width: 100%;
		max-width: 600px;
		max-height: 90vh;
		overflow-y: auto;
		border-radius: 15px;
	}

	.close-btn {
		position: absolute;
		top: 10px;
		right: 15px;
		font-size: 30px;
		color: white;
		background: transparent;
		border: none;
		cursor: pointer;
		z-index: 10000;
	}

	/* Reuse existing Zoho styles but ensure they apply */
	.zcwf_lblLeft .zcwf_title {
		color: #fff !important;

		font-size: 36px !important;
		font-weight: 500 !important;
		margin-bottom: 12px;
		margin-top: 20px;
		max-width: 75%;
	}

	.zcwf_subtitle {
		color: rgba(255, 255, 255, 0.9) !important;

		font-size: 16px !important;
		margin-bottom: 32px;
	}

	/* Ensure modal form looks like the original */
	#crmWebToEntityForm_modal {
		background: #0085f6 !important;
		/* Removed cardBg.svg to allow new background image to show */
		padding: 40px 50px 20px 50px !important;
		border-radius: 15px !important;
		position: relative;
		z-index: 1;
		overflow: hidden;
	}

	#Last_Name_modal,
	#Email_modal {
		min-height: auto !important;
		width: 100% !important;
		padding: 12px 10px !important;
		border-radius: 5px !important;
	}

	/* Ensure content sits above the background image */
	#crmWebToEntityForm_modal > form {
		position: relative;
		z-index: 1;
	}

	/* Form Layout Styles */
	.zcwf_row {
		display: flex;
		margin-bottom: 20px;
	}

	.zcwf_col_fld {
		flex: 1;
	}

	.zcwf_formVisibleFields_row {
		display: flex !important;
		flex-direction: column !important; /* Stack vertically */
		gap: 1.5rem !important; /* Increased gap */
		margin-bottom: 20px !important;
	}

	.zcwf_formVisibleFields_row .zcwf_col_fld {
		width: 100% !important; /* Full width */
		padding: 0 !important;
		margin: 0 !important;
	}

	.zcwf_lblLeft .zcwf_col_fld input[type="text"],
	.zcwf_lblLeft .zcwf_col_fld input[type="email"] {
		width: 100%;
		border: 1px solid rgba(255, 255, 255, 0.3) !important;
		border-radius: 8px;
		padding: 8px 12px !important; /* Reduced height (0.75x) */
		background-color: rgba(255, 255, 255, 0.95) !important;
		color: #333 !important;
		font-size: 14px !important;
	}

	.zcwf_lblLeft .zcwf_col_fld input::placeholder {
		color: #c8c1c1;
	}

	.zcwf_lblLeft .zcwf_col_lab {
		display: none;
	}

	.wfrm_fld_dpNn {
		display: none;
	}

	.zcwf_benefits {
		font-size: 12px;
		color: rgba(255, 255, 255, 0.6);
		margin-top: 20px;

		text-align: left; /* Left align */
	}

	.formsubmit.zcwf_button {
		width: 100%;
		background: transparent !important;
		color: white !important;
		border: 1px solid rgba(255, 255, 255, 0.4) !important;
		padding: 12px 28px !important;
		font-size: 18px !important;
		border-radius: 50px !important;
		cursor: pointer;
		transition: all 0.25s ease;
	}

	.formsubmit.zcwf_button:hover {
		background: rgba(255, 255, 255, 0.15) !important;
	}

	/* Background Image via Pseudo-element */
	#crmWebToEntityForm_modal::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 0; /* Changed from -1 to 0 to sit above background color but below content */
		background-image: url("/secondCTAbg.png");
		background-size: 95%;
		background-position: 1480% 100%;
		background-repeat: no-repeat;
		opacity: 0.5;
		pointer-events: none;
	}

	@media (max-width: 768px) {
		.modal-overlay {
			padding: 0;
		}

		.modal-container {
			width: 90%; /* Prevent touching edges */
			max-height: 85vh; /* Ensure it fits vertically */
			margin: auto; /* Robust centering */
		}

		#crmWebToEntityForm_modal {
			padding: 24px 20px !important; /* Reduced padding */
			background-position: center bottom !important;
			background-size: 80% !important;
			background-image: none !important;
		}

		.zcwf_title {
			font-size: 22px !important; /* Smaller title */
			margin-bottom: 8px !important;
		}

		.zcwf_subtitle {
			font-size: 14px !important;
			margin-bottom: 20px !important; /* Reduced margin */
		}

		.zcwf_formVisibleFields_row {
			flex-direction: column !important;
			gap: 12px !important; /* Reduced gap */
			margin-bottom: 16px !important;
		}

		.zcwf_benefits {
			margin-top: 16px;
			font-size: 11px;
		}

		.zcwf_lblLeft .zcwf_col_fld input[type="text"],
		.zcwf_lblLeft .zcwf_col_fld input[type="email"] {
			padding: 8px 12px !important; /* Reduced height (0.75x) */
			font-size: 13px !important;
		}

		.zcwf_formVisibleFields_row,
		.zcwf_formVisibleFields,
		.zcwf_col_fld {
			min-height: auto !important;
		}
	}
</style>

<script is:inline>
	// Modal Logic
	const modalOverlay = document.getElementById("zoho-modal-overlay");
	const closeBtn = document.getElementById("close-modal-btn");

	window.openZohoModal = function () {
		modalOverlay.style.display = "flex";
		document.body.style.overflow = "hidden"; // Prevent scrolling
	};

	window.closeZohoModal = function () {
		modalOverlay.style.display = "none";
		document.body.style.overflow = "auto";
	};

	if (closeBtn) {
		closeBtn.addEventListener("click", window.closeZohoModal);
	}

	if (modalOverlay) {
		modalOverlay.addEventListener("click", e => {
			if (e.target === modalOverlay) {
				window.closeZohoModal();
			}
		});
	}

	// Callback function executed when reCAPTCHA is solved (or invisible check passes)
	window.onCaptchaSuccess_modal = function (token) {
		console.log("Modal Captcha validated. Submitting form...");
		const form = document.getElementById("webform_modal");

		// Construct Redirect URL with Name and Email
		var nameField = document.getElementById("Last_Name_modal");
		var emailField = document.getElementById("Email_modal");
		var redirectURL = "https://coach.jove.com";

		if (nameField && emailField) {
			redirectURL += "?name=" + encodeURIComponent(nameField.value) + "&email=" + encodeURIComponent(emailField.value);
		}

		// Set returnURL hidden field
		var returnURLField = document.querySelector("#webform_modal input[name='returnURL']");
		if (returnURLField) {
			returnURLField.value = redirectURL;
		}

		// Submit the form programmatically
		HTMLFormElement.prototype.submit.call(form);
	};

	function validateEmail_modal() {
		var form = document.getElementById("webform_modal");
		var emailFld = form.querySelectorAll("[data-ftype=email]");
		var i;
		for (i = 0; i < emailFld.length; i++) {
			var emailVal = emailFld[i].value;
			if (emailVal.replace(/^\s+|\s+$/g, "").length != 0) {
				var atpos = emailVal.indexOf("@");
				var dotpos = emailVal.lastIndexOf(".");
				if (atpos < 1 || dotpos < atpos + 2 || dotpos + 2 >= emailVal.length) {
					alert("Please enter a valid email address. ");
					emailFld[i].focus();
					return false;
				}
			}
		}
		return true;
	}

	window.checkMandatory_modal = function () {
		var mndFileds = new Array("Last Name", "Email");
		var fldLangVal = new Array("Name", "Email");
		for (i = 0; i < mndFileds.length; i++) {
			var fieldObj = document.forms["webform_modal"][mndFileds[i]];
			if (fieldObj) {
				if (fieldObj.value.replace(/^\s+|\s+$/g, "").length == 0) {
					alert(fldLangVal[i] + " cannot be empty.");
					fieldObj.focus();
					return false;
				}
			}
		}
		if (!validateEmail_modal()) {
			return false;
		}

		// Validation passed. Execute Global reCAPTCHA.
		if (typeof window.executeGlobalRecaptcha === "function") {
			window.executeGlobalRecaptcha(window.onCaptchaSuccess_modal);
		} else {
			console.error("Global reCAPTCHA function not found.");
			alert("Please wait for reCAPTCHA to load.");
		}

		return false; // Stop immediate submission
	};

	// Attach submit handler manually since we can't use inline onSubmit easily with scoped functions
	const modalForm = document.getElementById("webform_modal");
	if (modalForm) {
		modalForm.onsubmit = function () {
			document.charset = "UTF-8";
			return window.checkMandatory_modal();
		};
	}

	// UTM Population for Modal
	(function () {
		const params = new URLSearchParams(window.location.search);
		const mapping = {
			utm_source: "CONTACTCF20_modal",
			utm_medium: "CONTACTCF19_modal",
			utm_campaign: "CONTACTCF17_modal",
			utm_term: "CONTACTCF21_modal",
			utm_content: "CONTACTCF18_modal",
			ad_id: "CONTACTCF4_modal",
			ad_set_id: "CONTACTCF7_modal",
			ad_name: "CONTACTCF5_modal",
			ad_platform: "CONTACTCF6_modal",
			ad_campaign_id: "CONTACTCF1_modal",
			ad_group_name: "CONTACTCF3_modal",
			ad_group_id: "CONTACTCF2_modal",
			ad_campaign_name: "CONTACTCF30_modal",
			landing_page_url: "CONTACTCF11_modal",
			referrer_url: "CONTACTCF14_modal",
		};

		for (const key in mapping) {
			const fieldId = mapping[key];
			const el = document.getElementById(fieldId);
			if (el && params.has(key)) {
				el.value = params.get(key);
			}
		}

		// Fallback for adset_id (no underscore)
		const adSetField = document.getElementById("CONTACTCF7_modal");
		if (adSetField && (adSetField.value === "-" || !adSetField.value) && params.has("adset_id")) {
			adSetField.value = params.get("adset_id");
		}

		// Fallback for campaign_name (if ad_campaign_name is missing)
		const campaignNameField = document.getElementById("CONTACTCF30_modal");
		if (campaignNameField && (campaignNameField.value === "-" || !campaignNameField.value) && params.has("campaign_name")) {
			campaignNameField.value = params.get("campaign_name");
		}

		// Handle Dropdowns
		const subsourceSelect = document.getElementById("CONTACTCF16_modal"); // Subsource
		const sourceSelect = document.getElementById("CONTACTCF15_modal"); // Source
		const platformSelect = document.getElementById("CONTACTCF6_modal"); // Ad Platform

		const gclid = params.get("gclid");
		const sources = params.getAll("source");
		const utmSource = params.get("utm_source");
		const utmMedium = params.get("utm_medium");
		const adPlatform = params.get("ad_platform");
		const adId = params.get("ad_id");
		// Referrer Logic: Check referrer_url, referrer, ref
		const referrerUrlParam = params.get("referrer_url") || params.get("referrer") || params.get("ref");

		// 1. Ad Platform
		if (platformSelect) {
			if (adPlatform) {
				const options = Array.from(platformSelect.options).map(o => o.value);
				if (options.includes(adPlatform)) platformSelect.value = adPlatform;
				else if (adPlatform.toLowerCase() === "google") platformSelect.value = "Google";
				else if (adPlatform.toLowerCase() === "meta" || adPlatform.toLowerCase() === "facebook") platformSelect.value = "Meta";
			} else if (gclid) {
				platformSelect.value = "Google";
			}
		}

		// 2. Source (Paid, Organic, Social)
		if (sourceSelect) {
			if (sources.some(s => s.toLowerCase() === "paid") || gclid || adId) {
				sourceSelect.value = "Paid";
			} else if (sources.some(s => s.toLowerCase() === "organic")) {
				sourceSelect.value = "Organic";
			} else if (sources.some(s => s.toLowerCase() === "social")) {
				sourceSelect.value = "Social";
			} else if (utmMedium && (utmMedium.toLowerCase().includes("cpc") || utmMedium.toLowerCase().includes("paid"))) {
				sourceSelect.value = "Paid";
			} else {
				// Default to Organic if nothing else matches? Or leave as is.
				// zohoform.html sets to Organic default.
				sourceSelect.value = "Organic";
			}
		}

		// 3. Subsource
		if (subsourceSelect) {
			let subsourceValue = "";
			const subsourceOptions = Array.from(subsourceSelect.options).map(o => o.value);

			// Check 'source' params
			for (const s of sources) {
				if (s.toLowerCase() === "google") subsourceValue = "Google Ads";
				else if (s.toLowerCase() === "facebook" || s.toLowerCase() === "meta") subsourceValue = "Meta Ads";
				else if (s.toLowerCase() === "linkedin") subsourceValue = "LinkedIn";
			}

			// Check utm_source
			if (!subsourceValue && utmSource) {
				if (utmSource.toLowerCase().includes("google")) subsourceValue = "Google Ads";
				else if (utmSource.toLowerCase().includes("facebook") || utmSource.toLowerCase().includes("meta")) subsourceValue = "Meta Ads";
				else if (utmSource.toLowerCase().includes("linkedin")) subsourceValue = "LinkedIn";
				else if (subsourceOptions.includes(utmSource)) subsourceValue = utmSource;
			}

			if (!subsourceValue && gclid) {
				subsourceValue = "Google Ads";
			}

			if (subsourceValue) {
				subsourceSelect.value = subsourceValue;
			} else if (!subsourceValue && !utmSource && !gclid) {
				// Fallback to Direct if nothing else
				subsourceSelect.value = "Direct";
			}
		}

		const landingField = document.getElementById("CONTACTCF11_modal");
		if (landingField) landingField.value = window.location.href;

		const refField = document.getElementById("CONTACTCF14_modal");
		if (refField) {
			if (referrerUrlParam) {
				refField.value = referrerUrlParam;
			} else {
				refField.value = document.referrer || "-";
			}
		}
	})();
</script>

---
import STEMstruggleIcon3 from "../../assets/STEMstruggleIcon3.svg";
import STEMstruggleIcon2 from "../../assets/STEMstruggleIcon2.svg";
import STEMstruggleIcon4 from "../../assets/STEMstruggleIcon4.svg";
import STEMstruggleIcon1 from "../../assets/STEMstruggleIcon1.svg";
import STEMstruggleImg1 from "../../assets/parents-pain-1.webp";
import STEMstruggleImg2 from "../../assets/parents-pain-2.webp";
import STEMstruggleImg3 from "../../assets/parents-pain-3.webp";
import STEMstruggleImg4 from "../../assets/parents-pain-4.webp";
import { Image } from "astro:assets";
import TrustedPartnersSection from "./trustedPartnersSection.astro";
import conceptsSectionIcon1 from "../../assets/conceptsSectionIcon1.svg";

// STEMStruggle.astro
const struggles = [
	{
		icon: STEMstruggleIcon3,
		title: "Lecture Fog",
		subtitle: "50 minutes in.",
		description: "Still confused.",
		image: STEMstruggleImg1,
	},
	{
		icon: STEMstruggleIcon2,
		title: "Textbook Loop",
		subtitle: "They Read it three times",
		description: "Still lost.",
		image: STEMstruggleImg2,
	},
	{
		icon: STEMstruggleIcon4,
		title: " Youtube Spiral",
		subtitle: "They search for help.",
		description: "Still no answer.",
		image: STEMstruggleImg3,
	},
	{
		icon: STEMstruggleIcon1,
		title: " Exam Panic",
		subtitle: "Exam tomorrow.",
		description: "Still unsure.",
		image: STEMstruggleImg4,
	},
];
---

<style>
	.stem-struggle {
		padding: 0rem 1.5rem 4rem 1.5rem;
		background-color: #ffffff;
	}

	.container {
		max-width: 1320px;
		margin: 0 auto;
	}

	.main-title {
		font-weight: 500;
		font-size: 36px;
		line-height: 150%;
		letter-spacing: 0%;
		text-align: center;
		color: #000;
		margin-top: 70px;
	}

	.highlight {
		color: #2183ed;
	}

	.subtitle {
		font-weight: 400;
		font-size: 18px;
		line-height: 25.2px;
		letter-spacing: 0%;
		text-align: center;
		max-width: 550px;
		margin: 0 auto 3rem auto;
		color: #3f3f3f;
	}

	.cards-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, 260px);
		justify-content: center;
		gap: 2.75rem;
		margin-bottom: 3rem;
	}

	.struggle-card {
		position: relative;
		max-width: 260px;
		height: auto;
		background: #ffffff;
		border-radius: 15px;
		padding: 1.5rem 0 0 0;
		box-shadow: 0px 10px 25px 0px #2183ed1a;
		transition:
			transform 0.3s ease,
			box-shadow 0.3s ease;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
	}
	.struggle-card {
		position: relative;
		border-radius: 16px; /* example */
	}

	.struggle-card::before {
		content: "";
		position: absolute;
		inset: 0;
		padding: 0.5px; /* border thickness */
		border-radius: inherit;

		background: linear-gradient(150.13deg, #1a67ba 2.98%, #ffffff 52.53%, #2183ed 102.08%);

		-webkit-mask:
			linear-gradient(#fff 0 0) content-box,
			linear-gradient(#fff 0 0);
		-webkit-mask-composite: xor;
		mask-composite: exclude;

		pointer-events: none;
	}

	.struggle-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
	}
	.card-text-contents {
		padding-left: 3rem;
	}
	.card-icon {
		font-size: 2rem;
		margin-bottom: 1rem;
	}

	.card-title {
		font-weight: 500;
		font-size: 20px;
		line-height: 120%;
		letter-spacing: 0%;
		color: #000;
		margin: 0 0 10px 0;
	}

	.card-subtitle {
		font-weight: 300;
		font-size: 16px;
		line-height: 140%;
		letter-spacing: 0%;
		color: #3f3f3f;
		margin: 0;
	}

	.card-description {
		font-weight: 300;
		font-size: 16px;
		line-height: 140%;
		letter-spacing: 0%;
		color: #3f3f3f;
		margin-top: 0;
	}

	.card-image {
		width: 100%;
		height: 223px;
		overflow: hidden;
	}

	.card-image img {
		width: 260px;
		height: 223px;
		object-fit: cover;
		border-radius: 15px;
	}

	.bottom-text {
		font-weight: 400;
		font-size: 18;
		line-height: 25.2px;
		letter-spacing: 0%;
		text-align: center;
		color: #3f3f3f;
		margin: 30px 0;
	}

	.cta-text {
		font-weight: 500;
		font-size: 22px;
		line-height: 160%;
		letter-spacing: 0%;
		text-align: center;
		color: #000;
		max-width: 660px;
		margin: 2rem auto 0 auto;
	}

	.cta-text img {
		width: 26px;
		height: auto;
		margin-bottom: -1px;
		margin-left: 6px;
		transform: translateY(4px);
	}

	.cta-text span {
		font-family: inherit;
		font-weight: inherit;
		font-size: inherit;
		line-height: inherit;
		letter-spacing: inherit;
		color: #2183ed;
		text-decoration: none;
	}

	/* Tablet */
	@media (max-width: 768px) {
		.stem-struggle {
			padding: 3rem 1rem;
		}

		.main-title {
			font-size: 1.75rem;
		}

		.cards-grid {
			grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
			gap: 1rem;
		}

		.card-image {
			height: 150px;
		}
	}

	/* Mobile */
	@media (max-width: 480px) {
		.stem-struggle {
			padding: 2rem 1rem;
		}

		.main-title {
			font-size: 1.5rem;
		}

		.subtitle {
			font-size: 0.9rem;
			margin-bottom: 2rem;
		}

		.cards-grid {
			grid-template-columns: 1fr;
			gap: 1rem;
			justify-items: center;
		}

		.card-title {
			font-size: 1.1rem;
		}

		.cta-text {
			font-size: 1.1rem;
		}
	}
</style>

<section class="stem-struggle">
	<TrustedPartnersSection />

	<div class="container">
		<h2 class="main-title">
			You want to help. <span class="highlight"> But STEM </span> isn't easy.
		</h2>

		<p class="subtitle"> You've tried everything—expensive tutors, YouTube videos, extra textbooks. Sound Familiar?</p>

		<div class="cards-grid">
			{
				struggles?.map(struggle => (
					<div class="struggle-card">
						<div class="card-text-contents">
							<Image class="card-icon" src={struggle?.icon} alt={struggle?.title} />
							<h3 class="card-title">{struggle?.title}</h3>
							<p class="card-subtitle">{struggle?.subtitle}</p>
							<p class="card-description">{struggle?.description}</p>
						</div>
						<div class="card-image">
							<Image src={struggle?.image} alt={struggle?.title} loading="lazy" />
						</div>
					</div>
				))
			}
		</div>

		<p class="bottom-text"> Your child isn't bad at science. They just haven't found the right way to learn it...</p>

		<p class="cta-text">
			19 years of JoVE clarity, Trusted by 1 Million+ students,<span><br /> now supercharged with</span>
			<Image src={conceptsSectionIcon1} alt={"AI"} />
		</p>
	</div>
</section>

---
import HeroSectionCTABg from "../assets/HeroSectionCTABg.svg";

interface Props {
	title?: string;
	subtitle?: string;
	ctaText?: string;
}

const { title = "The Smarter Way to Learn STEM", subtitle = "Try Jove Coach free for 7 days and experience AI-powered clarity for yourself.", ctaText = "Try It Free" } = Astro.props;
---

<div id="zoho-modal-overlay" class="modal-overlay" style="display: none;">
	<div class="modal-container">
		<!-- Modal Form Content -->
		<div id="crmWebToEntityForm_modal" class="zcwf_lblLeft crmWebToEntityForm" style={`--bg-image: url(${HeroSectionCTABg.src}); max-width: 600px;`}>
			<button id="close-modal-btn" class="close-btn">&times;</button>
			<div class="zcwf_title">{title}</div>
			<div class="zcwf_subtitle">{subtitle}</div>

			<form id="webform_modal" onsubmit="return false;">
				<div class="zcwf_row zcwf_formVisibleFields_row">
					<div class="zcwf_col_lab" style="font-size:12px; font-family: Arial;">
						<label for="Last_Name_modal">Name<span style="color:red;">*</span></label>
					</div>
					<div class="zcwf_col_fld">
						<input type="text" id="Last_Name_modal" name="modalName" placeholder="Name*" required class="global-form-input" />
						<div class="zcwf_col_help"></div>
					</div>

					<div class="zcwf_col_lab" style="font-size:12px; font-family: Arial;">
						<label for="Email_modal">Email<span style="color:red;">*</span></label>
					</div>
					<div class="zcwf_col_fld">
						<input type="email" id="Email_modal" name="modalEmail" placeholder="Email*" required class="global-form-input" />
						<div class="zcwf_col_help"></div>
					</div>
				</div>

				<div class="zcwf_row">
					<input type="hidden" name="modalFormSource" id="modalFormSourceInput" value="" />
					<input type="hidden" name="modalRedirectUrl" id="modalRedirectUrlInput" value="" />
					<button id="formsubmit_modal" class="global-form-btn" type="submit">{ctaText}</button>
				</div>

				<div class="zcwf_row">
					<div class="zcwf_col_fld" style="text-align: center;">
						<span class="modal-disclaimer">• 7 days free • Full access • No credit card</span>
					</div>
				</div>
			</form>
		</div>
	</div>
</div>

<script is:inline>
	// Modal Open/Close Logic
	let defaultTitle = "";
	let defaultSubtitle = "";
	let defaultCtaText = "";
	let defaultDisclaimer = "• 7 days free • Full access • No credit card";

	// Initialize defaults once the script runs
	const modalOverlay = document.getElementById("zoho-modal-overlay");
	if (modalOverlay) {
		const t = modalOverlay.querySelector(".zcwf_title");
		if (t) defaultTitle = t.innerHTML;
		const s = modalOverlay.querySelector(".zcwf_subtitle");
		if (s) defaultSubtitle = s.innerText;
		const b = modalOverlay.querySelector("#formsubmit_modal");
		if (b) defaultCtaText = b.innerText;
		const d = modalOverlay.querySelector(".modal-disclaimer");
		if (d) defaultDisclaimer = d.innerHTML;
	}

	window.openZohoModal = function (title, subtitle, ctaText, formSource, redirectUrl, customDisclaimer) {
		const overlay = document.getElementById("zoho-modal-overlay");
		if (overlay) {
			const titleEl = overlay.querySelector(".zcwf_title");
			if (titleEl) {
				titleEl.innerHTML = title || defaultTitle;
				if (subtitle === "NONE") {
					titleEl.classList.add("is-video-modal-title");
				} else {
					titleEl.classList.remove("is-video-modal-title");
				}
			}

			const subtitleEl = overlay.querySelector(".zcwf_subtitle");
			if (subtitleEl) {
				if (subtitle === "NONE") {
					subtitleEl.style.display = "none";
				} else {
					subtitleEl.style.display = "block";
					subtitleEl.innerText = subtitle || defaultSubtitle;
				}
			}

			const btnEl = overlay.querySelector("#formsubmit_modal");
			if (btnEl) btnEl.innerText = ctaText || defaultCtaText;

			const sourceInput = overlay.querySelector("#modalFormSourceInput");
			if (sourceInput) {
				sourceInput.value = formSource || "nav-modal";
			}

			const redirectInput = overlay.querySelector("#modalRedirectUrlInput");
			if (redirectInput) {
				redirectInput.value = redirectUrl || "";
			}

			const disclaimerEl = overlay.querySelector(".modal-disclaimer");
			if (disclaimerEl) {
				disclaimerEl.innerHTML = customDisclaimer || defaultDisclaimer;
				if (subtitle === "NONE" && !customDisclaimer) {
					disclaimerEl.style.display = "none";
				} else {
					disclaimerEl.style.display = "block";
				}
			}

			overlay.style.display = "flex";
			document.body.style.overflow = "hidden";
		}
	};

	window.closeZohoModal = function () {
		const overlay = document.getElementById("zoho-modal-overlay");
		if (overlay) {
			overlay.style.display = "none";
			overlay.classList.remove("video-transition");
			document.body.style.overflow = "auto";

			// Also close the video modal if it's open
			if (window.closeVideoModal) {
				window.closeVideoModal();
			}
		}
	};

	// Event Listeners
	const closeBtn = document.getElementById("close-modal-btn");
	if (closeBtn) closeBtn.addEventListener("click", window.closeZohoModal);

	const overlay = document.getElementById("zoho-modal-overlay");
	if (overlay) {
		overlay.addEventListener("click", e => {
			if (e.target === overlay) window.closeZohoModal();
		});
	}

	// Form Submission Logic
	const modalForm = document.getElementById("webform_modal");
	if (modalForm) {
		modalForm.addEventListener("submit", function (e) {
			e.preventDefault();
			console.log("Modal Form Submitted");

			const name = modalForm.querySelector('input[name="modalName"]').value;
			const email = modalForm.querySelector('input[name="modalEmail"]').value;
			const formSource = modalForm.querySelector('input[name="modalFormSource"]').value;
			let redirectUrl = modalForm.querySelector('input[name="modalRedirectUrl"]').value;

			// If no custom redirectUrl was passed into the modal, send null so master defaults to /home
			if (!redirectUrl || redirectUrl.trim() === "") {
				redirectUrl = null;
			}

			if (window.submitToZoho) {
				window.submitToZoho({ name, email, redirectUrl, formSource });

				// Close the video modal on submit as well
				if (window.closeVideoModal) {
					window.closeVideoModal();
				}
			} else {
				console.error("Master form function missing.");
				alert("Submission failed. Please try again later.");
			}
		});
	}
</script>

<style>
	@keyframes fadeInOverlay {
		from { opacity: 0; }
		to { opacity: 1; }
	}

	@keyframes scaleUpModal {
		from { transform: scale(0.95); opacity: 0; }
		to { transform: scale(1); opacity: 1; }
	}

	.modal-overlay {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(0, 0, 0, 0.5);
		backdrop-filter: blur(5px);
		z-index: 10005; /* Higher than Video Modal (10000) */
		display: flex;
		justify-content: center;
		align-items: center;
		padding: 20px;
	}

	.modal-overlay.video-transition[style*="display: flex"] {
		animation: fadeInOverlay 1s ease forwards;
		background: rgba(0, 0, 0, 0.15); /* Keep it much brighter */
	}

	.modal-container {
		position: relative;
		width: 100%;
		max-width: 550px;
		max-height: 90vh;
		overflow-y: auto;
		overflow-x: hidden; /* Prevent horizontal scroll */
		border-radius: 15px;
		background: transparent;
		box-shadow: none;
		box-sizing: border-box;
	}

	.modal-overlay.video-transition[style*="display: flex"] .modal-container {
		animation: scaleUpModal 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}

	/* Trust Pill Styles (Must be global for dynamically injected HTML) */
	:global(.modal-pill) {
		display: inline-flex;
		align-items: center;
		background: rgba(255, 255, 255, 0.1);
		border: 1px solid rgba(255, 255, 255, 0.15);
		padding: 4px 10px;
		border-radius: 20px;
		font-size: 11px; /* Increased by 1px */
		color: #fff;
		margin-top: -16px; /* Move up slightly more */
		margin-bottom: 20px;
		font-weight: 500;
		backdrop-filter: blur(4px);
	}
	:global(.modal-pill .stars) {
		color: #FFD700;
		margin-right: 4px;
		letter-spacing: 1px;
	}

	/* Zoho Form Styles (Simplified but matching Legacy) */
	#crmWebToEntityForm_modal {
		background-color: #0085f6 !important;
		/* Background SVG from PROPS/Previous Tool, handled via style var in HTML usually or hardcoded url if imported in script */
		/* Since I cannot inject dynamic src easily into CSS block, I will set it in HTML style attribute or use a variable */
		background-image: var(--bg-image);
		background-repeat: no-repeat;
		background-position: right -200px bottom;
		background-size: 60%;

		padding: 40px !important;
		border-radius: 12px;
		color: white !important;
		position: relative;
		box-sizing: border-box; /* Ensure padding doesn't affect width calculations */
		width: 100%; /* Ensure it fits container */
		max-width: 100% !important; /* Override inline max-width if needed */
	}

	.modal-overlay.video-transition #crmWebToEntityForm_modal {
		background-color: rgba(0, 133, 246, 0.85) !important; /* 85% opaque, 15% transparent */
		backdrop-filter: blur(12px);
	}

	.zcwf_title {
		font-weight: 500;
		font-size: 26px; /* Updated for desktop as requested */
		margin-bottom: 0.5rem;
		text-align: center;
		padding-top: 0;
		color: #fff !important;
		line-height: 1.2;
	}

	.zcwf_subtitle {
		text-align: center;
		color: rgba(255, 255, 255, 0.9) !important;
		margin-bottom: 30px;
		padding: 0 10px;
		font-size: 14px;

		margin-top: 1rem;
		line-height: 140%;
	}

	.zcwf_row {
		margin-bottom: 15px;
		padding: 0;
	}

	/* Input Row Layout */
	.zcwf_formVisibleFields_row {
		display: flex;
		flex-direction: column; /* Stack inputs vertically */
		gap: 15px; /* Add spacing between inputs */
		/* margin: 0 auto; */
	}

	.zcwf_col_fld {
		width: 100%; /* Full width for column layout */
	}

	/* Hiding labels as per request */
	.zcwf_col_lab {
		display: none;
	}

	.close-btn {
		position: absolute;
		top: 20px; /* Moved down */
		right: 20px; /* Moved left */
		background: transparent; /* Explicitly removed background */
		border: none;
		color: white !important;
		font-size: 30px;
		line-height: 1;
		cursor: pointer;
		opacity: 0.8;
		z-index: 100;
		padding: 0;
		width: auto;
		height: auto;
		transition: transform 0.3s ease;
	}

	.close-btn:hover {
		opacity: 1;
		transform: rotate(90deg);
	}

	.modal-disclaimer {
		font-size: 12px;
		color: rgba(255, 255, 255, 0.8);
		white-space: nowrap;
	}

	@media (max-width: 480px) {
		.modal-disclaimer {
			white-space: normal;
			font-size: 11px;
		}
		#crmWebToEntityForm_modal {
			padding: 30px 20px !important; /* Less padding on mobile to preventing squishing */
		}
		.close-btn {
			top: 10px;
			right: 10px;
		}
	}

	/* Ensure global inputs look good on blue bg */
	.global-form-input {
		border: 1px solid rgba(255, 255, 255, 0.3) !important;
		background: rgba(255, 255, 255, 0.1) !important;
		color: white !important;
	}

	.global-form-input::placeholder {
		color: rgba(255, 255, 255, 0.7);
	}

	.global-form-btn {
		background: white !important;
		color: #0085f6 !important;
		border: none !important;
		font-weight: 600 !important;
	}

	.global-form-btn:hover {
		background: #f0f0f0 !important;
		transform: translateY(-2px);
	}

	@media (max-width: 768px) {
		#crmWebToEntityForm_modal {
			background-position: right -180px bottom;
			background-size: 60%;
		}
	}

	.zcwf_title.is-video-modal-title {
		font-size: 22px !important;
		margin-bottom: 1.25rem !important;
	}

	@media (max-width: 768px) {
		.modal-container {
			min-width: 100% !important;
			max-width: 100% !important;
			padding: 2rem !important;
			margin-left: -50px;
		}
		#crmWebToEntityForm_modal {
			background-position: right -200px bottom;
		}
		.zcwf_title {
			font-size: 24px !important;
		}
		.zcwf_title.is-video-modal-title {
			font-size: 18px !important;
		}
	}
</style>

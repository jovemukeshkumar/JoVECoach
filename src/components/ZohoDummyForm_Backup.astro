---
interface Props {
	layout?: "horizontal" | "vertical";
	ctaText?: string;
	formIdSuffix?: string;
	redirectPath?: string;
	buttonLayout?: "full" | "inline";
	noteColor?: string;
	buttonMinWidth?: string;
}

const { layout = "vertical", ctaText = "Get Started Free", formIdSuffix = "dummy", redirectPath, buttonLayout = "full", noteColor = "#000", buttonMinWidth = "200px" } = Astro.props;
---

<form id={`dummy-form-${formIdSuffix}`} class={`zoho-dummy-form ${layout === "horizontal" ? "horizontal" : "vertical"}`} onsubmit="return false;">
	<div class="input-container">
		<input type="text" name="dummyName" placeholder="Name*" required class="global-form-input name-field" />
		<input type="email" name="dummyEmail" placeholder="Email*" required class="global-form-input email-field" />
	</div>

	<div class={`cta-wrapper ${buttonLayout}`}>
		<button type="submit" class="global-form-btn" style={`min-width: ${buttonMinWidth} !important;`}>
			{ctaText}
		</button>

		{
			(layout === "horizontal" || buttonLayout === "inline") && (
				<span class="cta-note" style={buttonLayout === "inline" ? `color: ${noteColor}; font-size: 13px; margin-left:10px;` : ""}>
					{buttonLayout === "inline" ? "No credit card" : "• 7 days free • Full access • No credit card"}
				</span>
			)
		}
	</div>
</form>

<script is:inline define:vars={{ formIdSuffix, redirectPath }}>
	(function () {
		const form = document.getElementById(`dummy-form-${formIdSuffix}`);
		if (form) {
			form.addEventListener("submit", function (e) {
				e.preventDefault();
				console.log(`Dummy form ${formIdSuffix} submitted.`);

				const name = form.querySelector('input[name="dummyName"]').value;
				const email = form.querySelector('input[name="dummyEmail"]').value;

				if (window.submitToZoho) {
					window.submitToZoho({ name, email, redirectUrl: redirectPath });
				} else {
					console.error("window.submitToZoho is not defined. Make sure ZohoMasterForm is included.");
					alert("Submission failed. Please try again later.");
				}
			});
		}
	})();
</script>

<style>
	.zoho-dummy-form {
		display: flex;
		gap: 1rem;
	}

	.zoho-dummy-form.vertical {
		flex-direction: column;
		width: 100%;
	}

	.zoho-dummy-form.horizontal {
		flex-direction: column;
	}

	.input-container {
		display: flex;
		gap: 0;
	}

	.horizontal .input-container {
		display: grid;
		grid-template-columns: 1fr 1fr;
	}

	.vertical .input-container {
		flex-direction: column;
		gap: 1rem;
	}

	/* Specific overrides for horizontal layout merging */
	.horizontal .input-container {
		margin-bottom: 0.25rem;
	}

	.horizontal .name-field {
		border-radius: 8px 0 0 8px;
		border-right: none;
	}

	.horizontal .email-field {
		border-radius: 0 8px 8px 0;

		width: 100% !important;
	}

	.cta-wrapper {
		display: flex;
		flex-direction: column;
		width: 100%;
	}

	.horizontal .cta-wrapper {
		flex-direction: row;
		align-items: center;
		gap: 1rem;
	}

	.horizontal .global-form-btn {
		width: auto !important;
		min-width: 200px;
		flex-shrink: 0;
	}

	.cta-note {
		font-size: 12px;
		color: #fff;
		line-height: 1.2;
		opacity: 0.8 !important;
	}

	.cta-wrapper.inline {
		flex-direction: row;
		align-items: center;
		justify-content: flex-start;
		gap: 0.5rem;
	}

	.cta-wrapper.inline .global-form-btn {
		width: auto !important;
		min-width: 200px;
	}

	@media (max-width: 480px) {
		.cta-wrapper.inline {
			flex-direction: column;
			align-items: stretch;
		}
		.cta-wrapper.inline .global-form-btn {
			width: 100%;
		}
		.cta-wrapper.inline .cta-note {
			margin-left: 0 !important;
			text-align: center;
			margin-top: 5px;
		}
	}

	/* Mobile responsive */
	@media (max-width: 768px) {
		.zoho-dummy-form {
			gap: 0.5rem;
		}
		.horizontal .input-container {
			grid-template-columns: 1fr;
			gap: 12px;
			/* padding-right: 2rem; */
		}

		.horizontal .name-field,
		.horizontal .email-field {
			border-radius: 8px !important;
			border-right: 1px solid #d1d5db; /* Restore border */
			font-size: 14px;
		}
		.horizontal .email-field {
			width: 100% !important;
		}

		.horizontal .cta-wrapper {
			flex-direction: column;
			gap: 1rem;
		}

		.horizontal .global-form-btn {
			width: 100%;
		}

		.cta-note {
			text-align: center;
		}

		.cta-wrapper.inline {
			margin-top: 0.5rem;
		}
	}
</style>

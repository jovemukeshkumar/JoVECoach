---
import { ZOHO_INTEGRATION_ENABLED } from "../config/zoho";
---

<div id="zoho-leads-form-container" style="display: none;">
	<form id="zoho-master-form" action="https://crm.zoho.in/crm/WebToLeadForm" name="WebToLeads_Master" method="POST" accept-charset="UTF-8">
		<!-- Active Leads Configuration (Moved from bottom of MasterForm) -->
		<input type="text" style="display:none;" name="xnQsjsdp" value="97b63ca06e39f1345bf59ceecacca2f8e21ffe4cf854ab1ec8d8a112a2051fd8" />
		<input type="hidden" name="zc_gad" id="zc_gad_master" value="" />
		<input type="text" style="display:none;" name="xmIwtLD" value="9d1fcc56eae30acd3ae3146b4c6c16c689975f0fe07f7d8b961a453e6f1ea30d0186b46b29641e92a97c1a22996870de" />
		<input type="text" style="display:none;" name="actionType" value="TGVhZHM=" />
		<input type="text" style="display:none;" name="returnURL" value="https://coach.jove.com/home" />

		<!-- Actual Data Fields -->
		<input type="text" style="display:none;" id="Last_Name_master" name="Last Name" maxlength="80" />
		<input type="text" style="display:none;" id="Email_master" name="Email" maxlength="100" />
		<input type="text" style="display:none;" id="Company_master" name="Company" maxlength="200" />

		<!-- UTM & Tracking Hidden Fields (LEADCF) -->
		<input type="text" style="display:none;" id="LEADCF11_master" name="LEADCF11" value="" />
		<input type="text" style="display:none;" id="LEADCF8_master" name="LEADCF8" value="" />
		<input type="text" style="display:none;" id="LEADCF9_master" name="LEADCF9" value="" />
		<input type="text" style="display:none;" id="LEADCF10_master" name="LEADCF10" value="" />
		<input type="text" style="display:none;" id="LEADCF7_master" name="LEADCF7" value="" />
		<input type="text" style="display:none;" id="LEADCF4_master" name="LEADCF4" value="" />
		<input type="text" style="display:none;" id="LEADCF13_master" name="LEADCF13" value="" />
		<input type="text" style="display:none;" id="LEADCF17_master" name="LEADCF17" value="" />
		<input type="text" style="display:none;" id="LEADCF14_master" name="LEADCF14" value="" />
		<input type="text" style="display:none;" id="LEADCF6_master" name="LEADCF6" value="" />
		<input type="text" style="display:none;" id="LEADCF18_master" name="LEADCF18" value="" />
		<input type="text" style="display:none;" id="LEADCF5_master" name="LEADCF5" value="" />
		<input type="text" style="display:none;" id="LEADCF12_master" name="LEADCF12" value="" />

		<!-- New Fields: Landing Page & Referrer URL -->
		<textarea style="display:none;" id="LEADCF23_master" name="LEADCF23"></textarea>
		<textarea style="display:none;" id="LEADCF16_master" name="LEADCF16"></textarea>
		<input type="text" style="display:none;" id="LEADCF29_master" name="LEADCF29" value="" />

		<!-- Helper fields for selects -->
		<select style="display:none;" id="LEADCF25_master" name="LEADCF25">
			<option value="-None-">-None-</option>
			<option selected value="Paid">Paid</option>
			<option value="Organic">Organic</option>
			<option value="Social">Social</option>
		</select>

		<select style="display:none;" id="LEADCF26_master" name="LEADCF26">
			<option value="-None-">-None-</option>
			<option value="SEO">SEO</option>
			<option value="Blog">Blog</option>
			<option value="Direct">Direct</option>
			<option selected value="Google Ads">Google Ads</option>
			<option value="Meta Ads">Meta Ads</option>
			<option value="Reddit Ads">Reddit Ads</option>
			<option value="Tiktok Ads">Tiktok Ads</option>
			<option value="Other Paid">Other Paid</option>
			<option value="Instagram">Instagram</option>
			<option value="Facebook">Facebook</option>
			<option value="Linkedin">Linkedin</option>
			<option value="Twitter/X">Twitter/X</option>
			<option value="YouTube">YouTube</option>
			<option value="Other Socials">Other Socials</option>
		</select>

		<input type="text" type="hidden" style="display: none;" name="aG9uZXlwb3Q" value="" />
	</form>
</div>

<script is:inline define:vars={{ ZOHO_INTEGRATION_ENABLED }}>
	// Global function to be called by dummy forms (Overwrites MasterForm version if both loaded, but safer for testing)
	window.getUtmSearchKeyword = function () {
		const params = new URLSearchParams(window.location.search);
		const raw = params.get("utm_term") || params.get("utm_keyword") || params.get("keyword") || "";
		const trimmed = raw.trim();
		return trimmed.length > 0 ? trimmed : "";
	};

	const LANDING_TRACKING_PARAMS = [
		"utm_source",
		"utm_medium",
		"utm_campaign",
		"utm_term",
		"utm_content",
		"gclid",
		"fbclid",
		"msclkid",
	];

	/** Copy UTM / ad click IDs from the landing page URL onto a target URL. */
	window.appendLandingTrackingParams = function (url) {
		const params = new URLSearchParams(window.location.search);
		for (const key of LANDING_TRACKING_PARAMS) {
			if (params.has(key)) {
				url.searchParams.set(key, params.get(key));
			}
		}
		return url;
	};

	/** Add landing-page tracking params to a touchpoint destination URL. */
	window.withLandingTrackingOnDestination = function (destination) {
		if (!destination || !destination.startsWith("http")) return destination;
		try {
			return window.appendLandingTrackingParams(new URL(destination)).toString();
		} catch {
			return destination;
		}
	};

	/** Touchpoint destination URL (value for redirecturi), not the full return URL. */
	window.getOpenFormRedirectUri = function () {
		const searchQuery = window.getUtmSearchKeyword();
		if (searchQuery) {
			const url = new URL("https://coach.jove.com/coach/");
			url.searchParams.set("searchQuery", searchQuery);
			url.searchParams.set("page", "home");
			return url.toString();
		}
		return window.inlineCoachRedirectFallback || "";
	};

	/** https://coach.jove.com/home?redirecturi=...&username=...&utm_*=... */
	window.buildHomeReturnUrl = function ({ redirectUri, name, email, organizationName }) {
		const url = new URL("https://coach.jove.com/home");
		if (redirectUri) {
			url.searchParams.set("redirecturi", redirectUri);
		}
		if (name) url.searchParams.set("username", name);
		if (email) url.searchParams.set("email", email);
		if (organizationName) url.searchParams.set("organizationName", organizationName);
		return window.appendLandingTrackingParams(url).toString();
	};

	window.submitToZoho = function (data) {
		console.log("submitToZoho (Leads) called with:", data);

		const { name, email, organizationName, formSource, redirectUri } = data;

		if (!name || !email) {
			console.error("Name and Email are required for Zoho submission.");
			return;
		}

		const form = document.getElementById("zoho-master-form");
		const nameInput = document.getElementById("Last_Name_master");
		const emailInput = document.getElementById("Email_master");
		const companyInput = document.getElementById("Company_master");
		const sourceInput = document.getElementById("LEADCF29_master");
		const returnURLInput = form.querySelector('input[name="returnURL"]');

		// 1. Populate Data
		nameInput.value = name;
		emailInput.value = email;
		if (companyInput) {
			companyInput.value = organizationName || "";
		}
		if (sourceInput && formSource) {
			sourceInput.value = formSource;
		}

		// 2. Construct Return URL — always coach.jove.com/home?redirecturi=...
		const rawDestination = redirectUri || window.getOpenFormRedirectUri();
		const destination = window.withLandingTrackingOnDestination(rawDestination);
		returnURLInput.value = window.buildHomeReturnUrl({
			redirectUri: destination,
			name,
			email,
			organizationName,
		});

		if (window.ZOHO_INTEGRATION_ENABLED === false || ZOHO_INTEGRATION_ENABLED === false) {
			console.warn("Zoho integration paused — skipping CRM POST. Redirecting to:", returnURLInput.value);
			window.location.href = returnURLInput.value;
			return;
		}

		console.log("Submitting Leads Form...", returnURLInput.value);

		// 3. Submit via Fetch to intercept JSON and manually redirect
		const formData = new FormData(form);

		fetch(form.action, {
			method: "POST",
			body: formData,
			mode: "no-cors", // Zoho doesn't support CORS for these forms natively from arbitrary domains
		})
			.then(() => {
				console.log("Form submitted. Redirecting to:", returnURLInput.value);
				window.location.href = returnURLInput.value;
			})
			.catch(err => {
				console.error("Form submission failed:", err);
				window.location.href = returnURLInput.value;
			});
	};

	// UTM Population (Run on load)
	(function () {
		const params = new URLSearchParams(window.location.search);
		const suffix = "_master";

		const mapping = {
			utm_source: `LEADCF8${suffix}`,
			utm_medium: `LEADCF9${suffix}`,
			utm_campaign: `LEADCF11${suffix}`,
			utm_term: `LEADCF7${suffix}`,
			utm_content: `LEADCF10${suffix}`,
			ad_id: `LEADCF13${suffix}`,
			ad_set_id: `LEADCF14${suffix}`,
			ad_name: `LEADCF18${suffix}`,
			ad_platform: `LEADCF12${suffix}`,
			ad_campaign_id: `LEADCF4${suffix}`,
			ad_group_name: `LEADCF5${suffix}`,
			ad_group_id: `LEADCF17${suffix}`,
			ad_campaign_name: `LEADCF6${suffix}`,
		};

		for (const key in mapping) {
			const fieldId = mapping[key];
			const el = document.getElementById(fieldId);
			if (el && params.has(key)) {
				el.value = params.get(key);
			}
		}

		// Populate Landing Page & Referrer
		const landingField = document.getElementById(`LEADCF23${suffix}`);
		if (landingField) landingField.value = window.location.href;

		const refField = document.getElementById(`LEADCF16${suffix}`);
		if (refField) {
			const referrerUrlParam = params.get("referrer_url") || params.get("referrer") || params.get("ref");
			if (referrerUrlParam) {
				refField.value = referrerUrlParam;
			} else {
				refField.value = document.referrer || "-";
			}
		}

		const sourceSelect = document.getElementById(`LEADCF25${suffix}`);
		const subsourceSelect = document.getElementById(`LEADCF26${suffix}`);

		const gclid = params.get("gclid");
		const sources = params.getAll("source");
		const utmSource = params.get("utm_source");
		const utmMedium = params.get("utm_medium");

		if (sourceSelect) {
			if (sources.some(s => s.toLowerCase() === "paid") || gclid || params.get("ad_id")) {
				sourceSelect.value = "Paid";
			} else if (sources.some(s => s.toLowerCase() === "organic")) {
				sourceSelect.value = "Organic";
			} else if (sources.some(s => s.toLowerCase() === "social")) {
				sourceSelect.value = "Social";
			} else if (utmMedium && (utmMedium.toLowerCase().includes("cpc") || utmMedium.toLowerCase().includes("paid"))) {
				sourceSelect.value = "Paid";
			}
		}

		if (subsourceSelect) {
			let subsourceValue = "";
			for (const s of sources) {
				if (s.toLowerCase() === "google") subsourceValue = "Google Ads";
				else if (s.toLowerCase() === "facebook" || s.toLowerCase() === "meta") subsourceValue = "Meta Ads";
				else if (s.toLowerCase() === "linkedin") subsourceValue = "Linkedin";
			}
			if (!subsourceValue && utmSource) {
				if (utmSource.toLowerCase().includes("google")) subsourceValue = "Google Ads";
				else if (utmSource.toLowerCase().includes("facebook") || utmSource.toLowerCase().includes("meta")) subsourceValue = "Meta Ads";
				else if (utmSource.toLowerCase().includes("linkedin")) subsourceValue = "Linkedin";
			}
			if (!subsourceValue && gclid) subsourceValue = "Google Ads";

			if (subsourceValue) subsourceSelect.value = subsourceValue;
		}
	})();
</script>

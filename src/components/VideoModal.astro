---
import closeIcon from "../assets/crossIcon.svg";
import { Image } from "astro:assets";

interface Props {
	videoSrc?: string;
}

const { videoSrc } = Astro.props;
---

<div id="video-modal-overlay" class="video-modal-overlay" style="display: none;">
	<div class="video-modal-container">
		<button id="close-video-modal-btn" class="close-btn">
			<Image src={closeIcon} alt="Close" />
		</button>
		<div class="video-wrapper">
			<video id="hero-video-player" controls playsinline webkit-playsinline preload="none" width="100%" height="auto" style="max-width: 100%; display: block;">
				<source src={videoSrc} type="video/mp4" />
				Your browser does not support the video tag.
			</video>
		</div>
	</div>
</div>

<script is:inline>
	window.openVideoModal = function () {
		const overlay = document.getElementById("video-modal-overlay");
		const video = document.getElementById("hero-video-player");
		if (overlay && video) {
			overlay.style.display = "flex";
			document.body.style.overflow = "hidden";
			video.play();
		}
	};

	window.closeVideoModal = function () {
		const overlay = document.getElementById("video-modal-overlay");
		const video = document.getElementById("hero-video-player");
		if (overlay && video) {
			overlay.style.display = "none";
			document.body.style.overflow = "auto";
			video.pause();
			video.currentTime = 0;
		}
	};

	// Event Listeners
	const closeVideoBtn = document.getElementById("close-video-modal-btn");
	if (closeVideoBtn) closeVideoBtn.addEventListener("click", window.closeVideoModal);

	const videoOverlay = document.getElementById("video-modal-overlay");
	if (videoOverlay) {
		videoOverlay.addEventListener("click", e => {
			if (e.target === videoOverlay) window.closeVideoModal();
		});
	}
</script>

<style>
	.video-modal-overlay {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(0, 0, 0, 0.8);
		backdrop-filter: blur(5px);
		z-index: 10000; /* Higher than Zoho Modal */
		display: flex;
		justify-content: center;
		align-items: center;
		padding: 0 !important;
		margin: 0 !important;
	}

	@media (max-width: 768px) {
		.video-modal-overlay {
			padding: 0 !important;
		}
	}

	.video-modal-container {
		position: relative;
		width: 100%;
		max-width: 90%; /* Responsive width */
		background: transparent;
		box-shadow: none;
		box-sizing: border-box;
		margin: 0 auto;
	}

	@media (max-width: 768px) {
		.video-modal-container {
			width: 95vw; /* Use width instead of max-width to force size */
			max-width: 95vw;
			margin: 0 auto; /* Ensure centering */
			left: 0;
			right: 0;
		}
	}

	.video-wrapper {
		width: 100%;
		border-radius: 12px;
		overflow: hidden;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
		background: #000;
	}

	.close-btn {
		position: absolute;
		top: -40px;
		right: 0;
		background: transparent;
		border: none;
		cursor: pointer;
		opacity: 0.8;
		transition:
			transform 0.3s ease,
			opacity 0.3s;
		padding: 0;
		z-index: 10001;
	}

	.close-btn:hover {
		opacity: 1;
		transform: rotate(90deg);
	}

	.close-btn img {
		width: 20px;
		height: 20px;
		/* Filter to make it specific blue #0085f6 */
		filter: invert(33%) sepia(97%) saturate(2250%) hue-rotate(198deg) brightness(98%) contrast(98%);
	}
</style>

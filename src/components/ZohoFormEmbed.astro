---
interface Props {
	formIdSuffix: string;
	layout?: "horizontal" | "vertical";
}

const { formIdSuffix, layout = "vertical" } = Astro.props;
const formId = `webform_${formIdSuffix}`;
const recaptchaId = `recap_${formIdSuffix}`;
const callbackName = `onCaptchaSuccess_${formIdSuffix}`;
---

<script src="https://www.google.com/recaptcha/api.js" async defer></script>
<form id={formId} action="https://crm.zoho.in/crm/WebToContactForm" name={`WebToContacts_${formIdSuffix}`} method="POST" accept-charset="UTF-8" class={layout === "horizontal" ? "zoho-form-horizontal" : "zoho-form-vertical"}>
	<!-- Hidden Fields -->
	<input type="text" style="display:none;" name="xnQsjsdp" value="390c57945d5f522d4647d0c9d0a4b920a2cb44f83b87ec5e429a60bb20811285" />
	<input type="hidden" name="zc_gad" id={`zc_gad_${formIdSuffix}`} value="" />
	<input type="text" style="display:none;" name="xmIwtLD" value="ce504bcdda7f4f718465437a8dfd0092b41ab3e46ed84ba8025e8c1a1bf8af77f80e1f7fe8b98973a90e99288315377b" />
	<input type="text" style="display:none;" name="actionType" value="Q29udGFjdHM=" />
	<input type="text" style="display:none;" name="returnURL" value="null" />

	<!-- UTM Hidden Fields -->
	<input type="text" style="display:none;" id={`CONTACTCF11_${formIdSuffix}`} name="CONTACTCF11" value="https://" />
	<input type="text" style="display:none;" id={`CONTACTCF14_${formIdSuffix}`} name="CONTACTCF14" value="https://" />
	<input type="text" style="display:none;" id={`CONTACTCF20_${formIdSuffix}`} name="CONTACTCF20" value="-" />
	<input type="text" style="display:none;" id={`CONTACTCF19_${formIdSuffix}`} name="CONTACTCF19" value="-" />
	<input type="text" style="display:none;" id={`CONTACTCF17_${formIdSuffix}`} name="CONTACTCF17" value="-" />
	<input type="text" style="display:none;" id={`CONTACTCF21_${formIdSuffix}`} name="CONTACTCF21" value="-" />
	<input type="text" style="display:none;" id={`CONTACTCF18_${formIdSuffix}`} name="CONTACTCF18" value="-" />

	<!-- Default Values -->
	<select style="display:none;" name="CONTACTCF15"><option selected value="Paid">Paid</option></select>
	<select style="display:none;" name="CONTACTCF28"><option selected value="Lead">Lead</option></select>
	<select style="display:none;" name="CONTACTCF16"><option selected value="Direc">Direc</option></select>

	{
		layout === "horizontal" ? (
			<div class="input-row">
				<input type="text" class="input-field" id={`Last_Name_${formIdSuffix}`} name="Last Name" placeholder="Name*" required />
				<input type="email" class="input-field input-field-mail" id={`Email_${formIdSuffix}`} name="Email" placeholder="Email*" required />
			</div>
		) : (
			<div class="vertical-inputs">
				<input type="text" class="input-field" id={`Last_Name_${formIdSuffix}`} name="Last Name" placeholder="Name*" required />
				<input type="email" class="input-field" id={`Email_${formIdSuffix}`} name="Email" placeholder="Email*" required />
			</div>
		)
	}

	<div class="cta-bottom">
		<!-- Invisible reCAPTCHA -->
		<div class="g-recaptcha" data-sitekey="6LdHLyQsAAAAALp3_wGJDs9-K6k9N37-vPz0JS9m" data-callback={callbackName} data-size="invisible" id={recaptchaId}> </div>

		<button type="submit" class="cta-button" id={`btn_${formIdSuffix}`}>
			{layout === "horizontal" ? "Try It Free" : formIdSuffix === "cta2" ? "Ask Your First Question" : "Try an AI Explanation"}
		</button>

		{layout === "horizontal" && <span class="cta-note">• 7 days free • Full access • No credit card</span>}
	</div>
</form>

<style>
	/* Shared Styles */
	.input-field {
		width: 100%;
		padding: 14px 16px;
		border: 2px solid #eeeeee; /* Default for vertical */
		border-radius: 10px;
		font-size: 16px;
		font-family: Inter, sans-serif;
		outline: none;
		transition: all 0.3s;
	}

	.input-field:focus {
		border-color: #2183ed;
	}

	.cta-button {
		background: #2183ed; /* Default blue */
		color: white;
		border: none;
		padding: 12px 26px;
		border-radius: 30px;
		font-size: 18px;
		font-weight: 500;
		cursor: pointer;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
		white-space: nowrap;
	}

	.cta-button:hover {
		transform: translateY(-2px);
		box-shadow: 0 10px 25px rgba(33, 131, 237, 0.35);
	}

	/* Horizontal Layout (Hero) Specifics */
	.zoho-form-horizontal .input-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		margin-bottom: 20px;
	}

	.zoho-form-horizontal .input-field {
		border: 0.5px solid #3a3a3a99;
		border-radius: 8px 0px 0px 8px;
		max-width: 205px;
		min-height: 50px;
		padding: 0px 10px;
	}

	.zoho-form-horizontal .input-field-mail {
		border-radius: 0px 8px 8px 0px !important;
		border-left: none;
	}

	.zoho-form-horizontal .cta-bottom {
		display: flex;
		align-items: center;
		gap: 16px;
		flex-wrap: wrap;
	}

	.zoho-form-horizontal .cta-button {
		background: transparent;
		border: 1px solid #ffffff;
		padding: 14px 32px;
	}

	.zoho-form-horizontal .cta-note {
		font-family: Inter;
		font-size: 14px;
		color: #ffffff99;
	}

	/* Vertical Layout (CTAs) Specifics */
	.zoho-form-vertical {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		max-width: 327px;
	}

	.zoho-form-vertical .vertical-inputs {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.zoho-form-vertical .cta-button {
		width: 100%; /* Full width button for vertical forms */
		max-width: 100%;
	}

	/* Responsive Adjustments */
	@media (max-width: 768px) {
		.zoho-form-horizontal .input-row {
			grid-template-columns: 1fr;
		}
		.zoho-form-horizontal .input-field {
			border-radius: 8px !important;
			max-width: 100%;
		}
		.zoho-form-horizontal .input-field-mail {
			margin-top: 12px;
		}
		.zoho-form-horizontal .cta-bottom {
			flex-direction: column;
			align-items: stretch;
		}
	}
</style>

<script is:inline define:vars={{ formId, formIdSuffix, callbackName, recaptchaId }}>
	// Define the callback function globally with a unique name
	window[callbackName] = function (token) {
		console.log(`Captcha validated for ${formIdSuffix}. Submitting...`);
		const form = document.getElementById(formId);

		// Dynamic Return URL
		const nameVal = document.getElementById(`Last_Name_${formIdSuffix}`).value;
		const emailVal = document.getElementById(`Email_${formIdSuffix}`).value;
		const returnUrlInput = form.querySelector('input[name="returnURL"]');

		if (returnUrlInput) {
			const baseUrl = "https://coach.jove.com/signup";
			const redirectUrl = new URL(baseUrl);
			redirectUrl.searchParams.set("name", nameVal);
			redirectUrl.searchParams.set("email", emailVal);
			returnUrlInput.value = redirectUrl.toString();
		}

		// Submit programmatically
		HTMLFormElement.prototype.submit.call(form);
	};

	// Form Submission Handler
	const form = document.getElementById(formId);
	if (form) {
		form.onsubmit = function (e) {
			e.preventDefault();

			// Basic Validation
			const name = document.getElementById(`Last_Name_${formIdSuffix}`).value;
			const email = document.getElementById(`Email_${formIdSuffix}`).value;

			if (!name || !email) {
				alert("Please fill in all required fields.");
				return false;
			}

			// Execute Invisible reCAPTCHA
			// This will trigger the challenge if needed, then call the callback
			grecaptcha.execute(document.getElementById(recaptchaId).getAttribute("widget-id"));
		};
	}

	// UTM Population
	(function () {
		const params = new URLSearchParams(window.location.search);
		const mapping = {
			utm_source: `CONTACTCF20_${formIdSuffix}`,
			utm_medium: `CONTACTCF19_${formIdSuffix}`,
			utm_campaign: `CONTACTCF17_${formIdSuffix}`,
			utm_term: `CONTACTCF21_${formIdSuffix}`,
			utm_content: `CONTACTCF18_${formIdSuffix}`,
			landing_page_url: `CONTACTCF11_${formIdSuffix}`,
			referrer_url: `CONTACTCF14_${formIdSuffix}`,
		};

		for (const key in mapping) {
			const fieldId = mapping[key];
			const el = document.getElementById(fieldId);
			if (el && params.has(key)) {
				el.value = params.get(key);
			}
		}

		const landingField = document.getElementById(`CONTACTCF11_${formIdSuffix}`);
		if (landingField) landingField.value = window.location.href;

		const refField = document.getElementById(`CONTACTCF14_${formIdSuffix}`);
		if (refField) refField.value = document.referrer || "-";
	})();
</script>

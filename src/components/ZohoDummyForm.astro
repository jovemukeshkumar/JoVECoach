---
import GreenTick from "../assets/greentick.svg";
import { Image } from "astro:assets";

interface Props {
	layout?: "horizontal" | "vertical";
	ctaText?: string;
	formIdSuffix?: string;
	redirectPath?: string;
	redirectUri?: string;
	buttonLayout?: "full" | "inline";
	noteColor?: string;
	buttonMinWidth?: string;
	showFeatures?: boolean;
	formSource?: string;
}

const { layout = "vertical", ctaText = "Get Started Free", formIdSuffix = "dummy", redirectPath, redirectUri, buttonLayout = "full", noteColor = "#000", buttonMinWidth = "200px", showFeatures = false, formSource = "" } = Astro.props;
---

<form id={`dummy-form-${formIdSuffix}`} class={`zoho-dummy-form ${layout === "horizontal" ? "horizontal" : "vertical"}`} onsubmit="return false;">
	<div class="input-container">
		<input type="text" name="dummyName" placeholder="Name*" required class="global-form-input name-field" />
		<input type="email" name="dummyEmail" placeholder="Work Email*" required class="global-form-input email-field" />
		<input type="text" name="dummyOrgName" placeholder="Company Name*" required class="global-form-input company-field" />
	</div>

	<div class={`cta-wrapper ${buttonLayout}`}>
		<button type="submit" class="global-form-btn" style={`min-width: ${buttonMinWidth} !important;`} set:html={ctaText} />

		{
			showFeatures ? (
				<div class="features-list">
					<div class="feature-item">
						<Image src={GreenTick} alt="tick" class="tick-icon" />
						<span>7 days full access</span>
					</div>
					<div class="feature-item">
						<Image src={GreenTick} alt="tick" class="tick-icon" />
						<span>No credit card</span>
					</div>
					<div class="feature-item">
						<Image src={GreenTick} alt="tick" class="tick-icon" />
						<span>Cancel anytime</span>
					</div>
				</div>
			) : (
				(layout === "horizontal" || buttonLayout === "inline") && (
					<span class="cta-note" style={buttonLayout === "inline" ? `color: ${noteColor}; font-size: 13px; margin-left:10px;` : ""}>
						{buttonLayout === "inline" ? "No credit card" : "• 7 days free • Full access • No credit card"}
					</span>
				)
			)
		}
	</div>
</form>

<script is:inline define:vars={{ formIdSuffix, redirectPath, redirectUri, formSource }}>
	(function () {
		const form = document.getElementById(`dummy-form-${formIdSuffix}`);
		if (form) {
			form.addEventListener("submit", function (e) {
				e.preventDefault();
				console.log(`Dummy form ${formIdSuffix} submitted.`);

				const name = form.querySelector('input[name="dummyName"]').value;
				const email = form.querySelector('input[name="dummyEmail"]').value;
				const organizationName = form.querySelector('input[name="dummyOrgName"]').value;

				if (window.submitToZoho) {
					window.submitToZoho({ name, email, organizationName, redirectUrl: redirectPath, redirectUri, formSource });
				} else {
					console.error("window.submitToZoho is not defined. Make sure ZohoMasterForm is included.");
					alert("Submission failed. Please try again later.");
				}
			});
		}
	})();
</script>

<style>
	.zoho-dummy-form {
		display: flex;
		gap: 1rem;
	}

	.zoho-dummy-form.vertical {
		flex-direction: column;
		width: 100%;
	}

	.zoho-dummy-form.horizontal {
		flex-direction: column;
	}

	.input-container {
		display: grid;
		grid-template-columns: 0.8fr 1.2fr;
		column-gap: 0;
		margin-bottom: 0.25rem;
	}

	.name-field {
		border-radius: 8px 0 0 8px;
		border-right: none;
	}

	.email-field {
		border-radius: 0 8px 8px 0;
		width: 100% !important;
	}

	.company-field {
		grid-column: 1 / -1;
		width: 100%;
		margin-top: 15px;
		border-radius: 8px;
	}

	.cta-wrapper {
		display: flex;
		flex-direction: column;
		width: 100%;
	}

	.horizontal .cta-wrapper {
		flex-direction: row;
		align-items: center;
		gap: 1rem;
	}

	.horizontal .global-form-btn {
		width: auto !important;
		min-width: 200px;
		flex-shrink: 0;
	}

	.cta-note {
		font-size: 12px;
		color: #fff;
		line-height: 1.2;
		opacity: 0.8 !important;
	}

	.cta-wrapper.inline {
		flex-direction: row;
		align-items: center;
		justify-content: flex-start;
		gap: 0.5rem;
	}

	.cta-wrapper.inline .global-form-btn {
		width: auto !important;
		min-width: 200px;
	}

	@media (max-width: 480px) {
		.cta-wrapper.inline {
			flex-direction: column;
			align-items: stretch;
		}
		.cta-wrapper.inline .global-form-btn {
			width: 100%;
		}
		.cta-wrapper.inline .cta-note {
			margin-left: 0 !important;
			text-align: center;
			margin-top: 5px;
		}
	}

	/* Mobile responsive */
	@media (max-width: 768px) {
		.zoho-dummy-form {
			gap: 0.5rem;
		}
		.input-container {
			grid-template-columns: 1fr;
			gap: 12px;
		}

		.name-field,
		.email-field {
			border-radius: 8px !important;
			border-right: 1px solid #d1d5db;
			font-size: 14px;
		}

		.email-field {
			width: 100% !important;
		}

		.company-field {
			width: 100% !important;
			margin-top: 0px !important;
			font-size: 14px;
		}

		.horizontal .cta-wrapper {
			flex-direction: column;
			gap: 1rem;
		}

		.horizontal .global-form-btn {
			width: 100%;
		}

		.cta-note {
			text-align: center;
		}

		.cta-wrapper.inline {
			margin-top: 0.5rem;
		}
	}
	/* Features List Styles */
	.features-list {
		display: flex;
		flex-wrap: wrap; /* Allow wrapping on small screens if needed, though design implies inline row */
		gap: 12px;
		margin-top: 12px;
		width: 100%;
		justify-content: center;
	}

	.feature-item {
		display: flex;
		align-items: flex-start;
		gap: 6px;
		color: #000; /* Assuming black text as per earlier heading change */
		font-size: 13px;
		font-weight: 400;
	}

	.tick-icon {
		width: 14px;
		height: 14px;
	}

	/* Override for horizontal layout when features are shown */
	.zoho-dummy-form.horizontal:has(.features-list) .cta-wrapper {
		flex-direction: column; /* Force column to put features below button */
		align-items: flex-start;
	}

	.zoho-dummy-form.horizontal:has(.features-list) .global-form-btn {
		width: 100% !important; /* Full width button */
		min-width: unset;
	}

	@media (max-width: 768px) {
		.features-list {
			justify-content: center;
		}
	}
</style>

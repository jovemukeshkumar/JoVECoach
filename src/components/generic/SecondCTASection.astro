---
import { Image } from "astro:assets";
import ailearning from "../../assets/ailearning.svg";
import ZohoDummyForm from "../../components/ZohoDummyForm.astro";

interface Props {
	title?: string;
	subtitle?: string;
	ctaText?: string;
}

const { title = "Ready to try the <br /> “Ask → Watch → Practice” flow?", subtitle = "Ask a question and see how AI breaks it down in minutes.", ctaText = "Start My Free Trial" } = Astro.props;
---

<style>
	#Last_Name_cta2 {
		padding: 0 15px;
	}
	.ai-cta-section {
		padding: 4rem 1rem;
		/* margin-top: -120px; */
		/* margin-bottom: -100px; */
		margin-bottom: -40px;
		position: relative;
		z-index: 10;
	}

	.ai-cta-card {
		max-width: var(--cta-width);
		max-height: 280px;
		margin: 0 auto;
		background: #2183ed; /* Blue background */
		border-radius: 20px;
		padding: 2rem 4rem;
		display: grid;
		grid-template-columns: 1.2fr 1fr 1fr;
		align-items: flex-start;
		gap: 2rem;
		position: relative;
		z-index: 10;
		box-shadow: 0px 10px 40px rgba(0, 0, 0, 0.25);
		overflow: hidden; /* clip pseudo-element */
	}
	.ai-cta-card::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 0;

		background-image: url("../../assets/secondCTAbg.png");
		background-size: 40%; /* Adjusted for different image */
		background-position: right -100px center;
		background-repeat: no-repeat;
		opacity: 0.5;

		pointer-events: none;
	}
	.ai-cta-card > * {
		position: relative;
		z-index: 1;
	}

	.ai-cta-content {
		max-width: 445px;
		height: auto;
	}
	/* Left text */
	.ai-cta-content h3 {
		color: #fff; /* White text */
		margin: 0;
	}

	.ai-cta-content p {
		font-weight: 300;
		font-size: 18px;
		line-height: 140%;
		letter-spacing: 0%;
		max-width: 300px;
		color: #fff; /* White text */
	}

	.ai-cta-btn {
		background: #fff;
		color: #2183ed;
		border: none;
		padding: 12px 20px;
		border-radius: 30px;

		font-weight: 500;
		font-size: 18px;
		line-height: 28px;
		letter-spacing: 0%;
		text-align: center;
		cursor: pointer;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	.ai-cta-btn:hover {
		transform: translateY(-2px);
		box-shadow: 0 10px 25px rgba(255, 255, 255, 0.35);
	}

	/* Center icon */
	.ai-cta-icon {
		display: flex;
		justify-content: end;
	}

	.ai-cta-icon img {
		width: 100%;
		max-width: 150px; /* Reduced max-width to fit smaller column */
		height: auto;
	}

	/* Right form */
	.ai-cta-form {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		width: 100%;
	}

	/* ---------- Responsive ---------- */

	@media (max-width: 992px) {
		.ai-cta-card {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 2rem;
			text-align: left;
			padding: 2rem;
			height: auto;
			max-height: none;
		}

		.ai-cta-content {
			min-width: 0;
			width: 100%;
			height: auto;
		}

		.ai-cta-icon {
			display: none;
		}

		.ai-cta-form {
			width: 100%;
			max-width: 100%;
			align-items: flex-start;
		}

		.ai-cta-btn {
			max-width: 100%;
			width: 100%;
		}
	}

	@media (max-width: 768px) {
		.ai-cta-card {
			display: flex;
			flex-direction: column;
			gap: 2rem !important;
			text-align: center;
			align-items: center;
		}

		.ai-cta-content p {
			max-width: unset;
		}

		.ai-cta-form {
			align-items: center;
			width: 100%;
			max-width: 400px;
			margin: 0 auto;
		}
	}

	@media (max-width: 480px) {
		.ai-cta-content h3 {
			font-size: 22px;
		}

		.ai-cta-content p {
			font-size: 14px;
		}

		.ai-cta-btn {
			width: 100%;
		}
	}
</style>
<section class="ai-cta-section">
	<div class="ai-cta-card">
		<!-- Left content -->
		<div class="ai-cta-content">
			<h3 set:html={title} />
			<p>{subtitle}</p>
		</div>

		<!-- Right form -->
		<div class="ai-cta-form">
			<ZohoDummyForm layout="vertical" formIdSuffix="cta2" ctaText={ctaText} buttonLayout="inline" noteColor="#fff" />
		</div>

		<!-- Center icon -->
		<div class="ai-cta-icon">
			<Image src={ailearning} alt="AI Learning Icon" />
		</div>
	</div>
</section>

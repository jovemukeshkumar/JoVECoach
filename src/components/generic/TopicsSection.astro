---
import { Image } from "astro:assets";

import conceptsSectionIcon1 from "../../assets/conceptsSectionIcon1.svg";
import conceptsSectionIcon2 from "../../assets/conceptsSectionIcon2.svg";
import conceptsSectionIcon3 from "../../assets/conceptsSectionIcon3.svg";
import conceptsSectionIcon4 from "../../assets/conceptsSectionIcon4.svg";
import conceptsSectionIcon5 from "../../assets/conceptsSectionIcon5.svg";
import conceptsSectionIcon6 from "../../assets/conceptsSectionIcon6.svg";
import conceptsSectionIcon7 from "../../assets/conceptsSectionIcon7.svg";
import viewsIcon from "../../assets/viewsIcon.svg";
import timeIcon from "../../assets/playBtn.svg";
import ArrowIcon from "../../assets/Arrow.svg";

interface Feature {
	icon: string;
	text: string;
}

interface ConceptQuestion {
	icon: ImageMetadata;
	text: string;
}

interface Props {
	heading?: string;
	subheading?: string;
	features?: Feature[];
	videoSrc?: string;
	mobileVideoSrc?: string;
	questions?: ConceptQuestion[];
	videoPlaybackSpeed?: number;
	conceptCards?: any[];
	ctaText?: string;
	modalTitle?: string;
	modalSubtitle?: string;
	modalCtaText?: string;
	showDescription?: boolean;
	showSubheading?: boolean;
	playVideoOnClick?: boolean;
}

const {
	heading,
	subheading,
	features,
	videoSrc,
	mobileVideoSrc,
	questions,
	videoPlaybackSpeed = 1.0,
	conceptCards,
	ctaText = "Explore what 1M+ students see",
	modalTitle,
	modalSubtitle = "NONE",
	modalCtaText,
	showDescription = false,
	showSubheading = true,
	playVideoOnClick = false,
} = Astro.props;

// Icon mapping
const iconMap: Record<string, ImageMetadata> = {
	ai: conceptsSectionIcon1,
	curriculum: conceptsSectionIcon2,
	"ad-free": conceptsSectionIcon3,
	expert: conceptsSectionIcon4,
	secure: conceptsSectionIcon5,
	// Add more as needed or default
};

const defaultFeatures = [
	{ icon: "ai", text: "AI-powered Platform" },
	{ icon: "curriculum", text: "Curriculum-aligned" },
	{ icon: "ad-free", text: "Ad-free learning" },
	{ icon: "expert", text: "Expert-created content" },
	{ icon: "secure", text: "Secure & private" },
];

const featuresList = features || defaultFeatures;
---

<style>
	.concepts-section {
		padding: var(--section-padding-top) var(--section-padding-right-left) var(--section-padding-bottom);
		background: #fff;
		text-align: center;
		position: relative;
		z-index: 1;
	}

	.features {
		margin: 50px auto 20px auto;
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 35px;
		max-width: 940px;
	}

	.feature {
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.25) 0%, rgba(206, 228, 251, 0.25) 100%);
		border-radius: 15px;
		box-shadow: 0px 10px 20px 0px #2183ed26;
		border: 1px solid rgba(33, 131, 237, 0.15);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center; /* Center content vertically */
		padding: 20px;
		aspect-ratio: 1 / 1; /* Force square shape globally */
	}
	.feature p {
		font-weight: 500;
		font-size: 16px;
		line-height: 140%;
		letter-spacing: 0%;
		text-align: center;
		color: #3f3f3f;
		max-width: 120px;
		margin: 0 auto;
	}
	.feature img {
		margin-bottom: 10px;
		width: 40px;
		height: 40px;
	}

	/* Carousel */
	.carousel {
		position: relative;
		height: 320px;
		display: flex;
		justify-content: center;
		align-items: center;
		margin-bottom: 60px;
	}

	/* Video wrapper */
	.video-wrapper {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 20px;
		display: flex;
		justify-content: center;
	}

	/* Responsive video */
	.concepts-video {
		width: 100%;
		/* max-width: 899px; */
		height: auto;
		border-radius: 24px;
		object-fit: contain;
		outline: 10px solid white;
		outline-offset: -10px;
	}

	/* Tablet */
	@media (max-width: 900px) {
		.concepts-video {
			max-width: 100%;
			border-radius: 18px;
		}
	}

	/* Mobile */
	@media (max-width: 768px) {
		.video-wrapper {
			/* display: none; */
			padding: 0;
			margin-left: -20px;
			margin-right: -20px;
			width: calc(100% + 40px);
			max-width: calc(100% + 40px);
		}
		.concepts-video {
			border-radius: 0;
			width: 100%;
			max-width: 100%;
			outline: 5px solid white;
			outline-offset: -5px;
		}
	}

	/* Concept Cards Styles */
	.concept-cards-container {
		display: flex;
		justify-content: center;
		gap: 24px;
		margin: 30px auto 40px auto;
		width: 100%;
		max-width: 1240px;
		flex-wrap: nowrap;
		overflow-x: auto;
		padding: 40px 20px 40px 20px; /* Top/Bottom Padding for scroll and hover space */
	}

	/* Scrollbar styling */
	.concept-cards-container::-webkit-scrollbar {
		height: 6px; /* Visible scrollbar for desktop if needed */
	}
	.concept-cards-container::-webkit-scrollbar-thumb {
		background: #ccc;
		border-radius: 4px;
	}
	.concept-cards-container::-webkit-scrollbar-track {
		background: transparent;
	}

	/* Mobile specific scrollbar hiding/styling */
	@media (max-width: 900px) {
		.concept-cards-container::-webkit-scrollbar {
			display: none;
		}
	}

	.concept-card {
		flex: 0 0 220px;
		width: 240px;
		min-height: 365px;
		position: relative;
		border-radius: 20px;
		overflow: hidden;

		box-shadow:
			0 0 0 0.5px rgba(33, 131, 237, 0.5),
			/* thin border */ 0 10px 30px -10px rgba(0, 0, 0, 0.3);

		transition:
			transform 0.3s ease,
			box-shadow 0.3s ease;
		cursor: pointer;
		background: #000;
	}

	/* .concept-card:hover {
		transform: translateY(-8px);
		box-shadow:
			0 0 0 0.5px rgba(33, 131, 237, 0.5),
			thin border  0 10px 30px -10px rgba(0, 0, 0, 0.3);
	} 
  */

	.card-image-wrapper {
		position: relative;
		width: 100%;
		height: 365px;
		max-height: 365px;
		box-shadow: 0px 3.95px 49.11px 0px #00429433;
	}

	/* Image scaling */
	.concept-card :global(img.card-bg-image) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.5s ease;
	}

	.concept-card:hover :global(img.card-bg-image) {
		transform: scale(1.05); /* Subtle zoom on hover */
	}

	.card-overlay {
		position: absolute;
		inset: 0;
		pointer-events: none; /* Let clicks pass through if needed */
	}

	/* Top badges container */
	.card-top {
		position: absolute;
		top: 12px;
		left: 12px;
		right: 12px;
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		z-index: 2;
	}

	.card-stat {
		background: rgba(255, 255, 255, 0.95);
		border-radius: 5.35px; /* Slightly rounded rect */
		padding: 3px 6px;
		font-weight: 400;
		font-size: 10.91px;
		line-height: 140%;
		letter-spacing: -1%;
		display: flex;
		align-items: center;
		gap: 6px;
		box-shadow: 0px 0.89px 4.46px 0px #0000001a;
	}

	.card-stat svg {
		width: 12px;
		height: 12px;
		opacity: 0.7;
	}

	/* Views specific style if needed */
	.card-stat.views {
	}

	/* Time specific style */
	.card-stat.time {
	}

	/* Bottom Gradient Overlay */
	.card-bottom {
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		padding: 40px 16px 15px 16px; /* Increased bottom padding to prevent text clipping */
		background: linear-gradient(to top, #2e2e2e 0%, transparent 100%);
		display: flex;
		align-items: flex-end;
		z-index: 2;
	}

	.card-bottom h3 {
		font-weight: 700;
		font-size: 12.81px;
		line-height: 140%;
		letter-spacing: 0%;
		vertical-align: middle;
		margin: 0;
		color: #fff;
		text-shadow: 0 1px 2px linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, #000000 100%);
		text-align: left;
		overflow-wrap: break-word;
		word-break: break-word;
	}

	.card-description {
		padding: 16px;
		font-size: 14px;
		line-height: 1.4;
		color: #fff;
		background: #000;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
	}

	@media (max-width: 900px) {
		.concept-cards-container {
			justify-content: flex-start;
			margin: 40px auto;
			gap: 16px;
			scroll-snap-type: x mandatory;
			scroll-behavior: smooth;
			padding-left: 0;
			padding-right: 0;
			padding-top: 20px; /* Space for hover lift */
			padding-bottom: 40px; /* Space for shadow */
		}

		.concept-card {
			flex: 0 0 180px;
			width: 180px;
			min-height: 320px;
			scroll-snap-align: center;
		}

		/* Carousel Wrapper & Buttons */
		.carousel-wrapper {
			position: relative;
			display: flex;
			align-items: center;
			justify-content: center;
			width: 100%;
		}

		/* Container for the button */
		.carousel-nav-wrapper {
			position: absolute;
			height: calc(100% - 60px); /* Subtract margin/padding offset if needed, or keeping 100% might cover padding */
			top: 20px; /* Start after top padding */
			bottom: 40px;
			border: none;
			display: flex !important; /* Force override */
			align-items: center;
			justify-content: center;
			z-index: 10;
			top: 0;
			transition: opacity 0.3s ease;
		}

		.carousel-nav-wrapper.left {
			left: 0;
			padding-right: 12px;
			padding-left: 0;
		}

		.carousel-nav-wrapper.right {
			right: 0;
			padding-left: 12px;
			padding-right: 0;
		}

		/* Netflix-style Button */
		.carousel-btn {
			height: 5rem; /* ~120px */
			width: 1.5rem; /* ~24px */
			border-radius: 0.5rem;
			border: none;
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 0;
			margin: 0;
			transition:
				background-color 0.2s ease-in-out,
				color 0.2s ease-in-out;
			color: rgba(255, 255, 255, 0.7);
			background-color: rgba(0, 0, 0, 0.6);
			cursor: pointer;
			backdrop-filter: blur(2px);
		}

		.carousel-btn:hover {
			background-color: rgba(0, 0, 0, 0.2);
			color: white;
		}

		.carousel-btn svg {
			width: 24px;
			height: 24px;
			fill: currentColor;
		}

		/* Left button content mirroring */
		.carousel-nav-wrapper.left .carousel-btn svg {
			transform: rotate(180deg);
		}

		/* Hidden state */
		.hidden {
			opacity: 0;
			pointer-events: none;
		}
	}

	/* Hide buttons on desktop by default */
	.carousel-nav-wrapper {
		display: none;
	}

	@keyframes autoSlide {
		0% {
			transform: translateX(0);
		}
		100% {
			transform: translateX(-50%);
		}
	}

	/* CTA */
	.cta button {
		background: #2183ed;
		color: #fff;
		padding: 14px 36px;
		border-radius: 30px;
		border: none;

		font-weight: 400;
		font-size: 16px;
		line-height: 140%;
		letter-spacing: -0.5%;
		cursor: pointer;
	}
	.cta button:hover {
		background: #1558d6;
	}

	/* Responsive */
	@media (max-width: 900px) {
		.features {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 20px;
		}

		.feature {
			flex: 0 0 160px; /* Fixed width, no growing */
			width: 160px;
			max-width: 160px; /* strict limit */
			aspect-ratio: 1 / 1;
			padding: 20px; /* Keep padding consistent */
		}

		.carousel {
			height: 260px;
		}

		.card.left,
		.card.right {
			display: none;
		}
	}

	@media (max-width: 768) {
		.concepts-section {
			padding: 48px 0;
		}
	}

	@media (max-width: 768px) {
		.features {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 8px; /* Gap between items */
			margin: 30px auto 20px auto;
		}
		.feature {
			/* Exact width for 3 items: (100% - 2 * gap) / 3 */
			flex: 0 0 calc(33.33% - 30px);
			width: calc(33.33% - 6px);
			min-width: unset;
			padding: 10px 4px !important;

			/* Force square */
			aspect-ratio: 1 / 1;
			/* Ensure content is centered */
			justify-content: center;
		}
		.feature p {
			font-size: 11px !important; /* Slightly smaller to fit */
			line-height: 1.1;
			margin: 0; /* Remove potential default margins */
		}
		.feature img {
			width: 24px;
			height: 24px;
			margin-bottom: 4px;
		}
	}
</style>
<section class="concepts-section">
	<div class="container">
		<!-- Heading -->
		<div class="heading">
			<h2 set:html={heading} />
			{showSubheading && subheading && <p>{subheading}</p>}
		</div>

		{
			conceptCards && conceptCards.length > 0 ? (
				<div class="carousel-wrapper">
					<div class="carousel-nav-wrapper left hidden">
						<button class="carousel-btn left" aria-label="Scroll Left">
							<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" role="img">
								<path fill="currentColor" fill-rule="evenodd" d="m15.586 12-7.293 7.293 1.414 1.414 8-8a1 1 0 0 0 0-1.414l-8-8-1.414 1.414z" clip-rule="evenodd" />
							</svg>
						</button>
					</div>

					<div class="concept-cards-container">
						{conceptCards.map(card => (
							<div class="concept-card" onclick={`window.openZohoModal && window.openZohoModal('${modalTitle || ""}', '${modalSubtitle || ""}', '${modalCtaText || ""}')`}>
								<div class="card-image-wrapper">
									<Image src={card.image} alt={card.title} class="card-bg-image" />
									<div class="card-overlay">
										<div class="card-top">
											<div class="card-stat views">
												<Image src={viewsIcon} alt="Views" />
												{card.views}
											</div>
											<div class="card-stat time">
												<Image src={timeIcon} alt="Time" />
												{card.time}
											</div>
										</div>
										<div class="card-bottom">
											<h3>{card.title}</h3>
										</div>
									</div>
								</div>
								{showDescription && card.description && <div class="card-description">{card.description}</div>}
							</div>
						))}
					</div>

					<div class="carousel-nav-wrapper right">
						<button class="carousel-btn right" aria-label="Scroll Right">
							<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" role="img">
								<path fill="currentColor" fill-rule="evenodd" d="m15.586 12-7.293 7.293 1.414 1.414 8-8a1 1 0 0 0 0-1.414l-8-8-1.414 1.414z" clip-rule="evenodd" />
							</svg>
						</button>
					</div>
				</div>
			) : (
				<>
					{/* Feature icons */}
					{/* <div class="features">
            {featuresList.map((feature) => (
              <div class="feature">
                <Image
                  src={iconMap[feature.icon] || conceptsSectionIcon1}
                  alt={feature.text}
                />
                <p>{feature.text}</p>
              </div>
            ))}
          </div>

          <div class="video-wrapper">
            <video
              class="concepts-video"
              autoplay
              muted
              loop
              playsinline
              data-speed={videoPlaybackSpeed}
            >
              <source
                src={mobileVideoSrc}
                type="video/webm"
                media="(max-width: 768px)"
              />
              <source src={videoSrc} type="video/webm" />
              Your browser does not support the video tag.
            </video>
          </div> */}
				</>
			)
		}

		<script>
			document.addEventListener("DOMContentLoaded", () => {
				const videos = document.querySelectorAll("video.concepts-video");
				videos.forEach(vid => {
					const videoEl = vid as HTMLVideoElement;
					const speed = parseFloat(videoEl.dataset.speed || "1.0");
					videoEl.playbackRate = speed;
				});

				// Carousel Logic
				// Carousel Logic
				const container = document.querySelector(".concept-cards-container");
				const leftNav = document.querySelector(".carousel-nav-wrapper.left");
				const rightNav = document.querySelector(".carousel-nav-wrapper.right");
				const leftBtn = document.querySelector(".carousel-btn.left");
				const rightBtn = document.querySelector(".carousel-btn.right");

				if (container && leftBtn && rightBtn && leftNav && rightNav) {
					const scrollAmount = 240; // Approx one card width + gap

					const updateArrows = () => {
						const { scrollLeft, scrollWidth, clientWidth } = container;
						// Tolerance for rounding errors
						const isAtStart = scrollLeft <= 10;
						const isAtEnd = Math.abs(scrollWidth - scrollLeft - clientWidth) <= 10;

						if (isAtStart) {
							leftNav.classList.add("hidden");
						} else {
							leftNav.classList.remove("hidden");
						}

						if (isAtEnd) {
							rightNav.classList.add("hidden");
						} else {
							rightNav.classList.remove("hidden");
						}
					};

					// Initial check
					updateArrows();

					// Listen for scroll
					container.addEventListener("scroll", () => {
						// Minimal throttle via rAF could be added if needed, but direct call usually fine for UI toggles
						window.requestAnimationFrame(updateArrows);
					});

					leftBtn.addEventListener("click", () => {
						container.scrollBy({ left: -scrollAmount, behavior: "smooth" });
					});

					rightBtn.addEventListener("click", () => {
						container.scrollBy({ left: scrollAmount, behavior: "smooth" });
					});

					// Also update on resize
					window.addEventListener("resize", updateArrows);
				}
			});
		</script>

		<!-- CTA -->
		<div class="cta">
			<button onclick="window.openZohoModal && window.openZohoModal()">{ctaText}</button>
		</div>
	</div>
</section>

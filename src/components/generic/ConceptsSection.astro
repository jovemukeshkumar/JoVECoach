---
import { Image } from "astro:assets";

import conceptsSectionIcon1 from "../../assets/conceptsSectionIcon1.svg";
import conceptsSectionIcon2 from "../../assets/conceptsSectionIcon2.svg";
import conceptsSectionIcon3 from "../../assets/conceptsSectionIcon3.svg";
import conceptsSectionIcon4 from "../../assets/conceptsSectionIcon4.svg";
import conceptsSectionIcon5 from "../../assets/conceptsSectionIcon5.svg";
import conceptsSectionIcon6 from "../../assets/conceptsSectionIcon6.svg";
import conceptsSectionIcon7 from "../../assets/conceptsSectionIcon7.svg";
import conceptsSectionIcon8 from "../../assets/conceptsSectionIcon8.svg";
import conceptsSectionIcon9 from "../../assets/conceptsSectionIcon9.svg";
import conceptsSectionIcon10 from "../../assets/conceptsSectionIcon6.svg";

interface Feature {
	icon: string;
	text: string;
}

interface ConceptQuestion {
	icon: ImageMetadata;
	text: string;
}

interface Props {
	heading?: string;
	subheading?: string;
	features?: Feature[];
	videoSrc?: string;
	mobileVideoSrc?: string;
	questions?: ConceptQuestion[];
	videoPlaybackSpeed?: number;
}

const { heading, subheading, features, videoSrc, mobileVideoSrc, questions, videoPlaybackSpeed = 1.0 } = Astro.props;

// Icon mapping
const iconMap: Record<string, ImageMetadata> = {
	"ai": conceptsSectionIcon1,
	"curriculum": conceptsSectionIcon2,
	"ad-free": conceptsSectionIcon3,
	"expert": conceptsSectionIcon4,
	"secure": conceptsSectionIcon5,
	// Add more as needed or default
};

const defaultFeatures = [
	{ icon: "ai", text: "AI-powered Platform" },
	{ icon: "curriculum", text: "Curriculum-aligned" },
	{ icon: "ad-free", text: "Ad-free learning" },
	{ icon: "expert", text: "Expert-created content" },
	{ icon: "secure", text: "Secure & private" },
];

const featuresList = features || defaultFeatures;

const defaultQuestions = [
	{ icon: conceptsSectionIcon6, text: "Why does respiration release energy?" },
	{ icon: conceptsSectionIcon7, text: "How does Newton's third law work?" },
];

const questionsList = questions || defaultQuestions;
---

<style>
	.concepts-section {
		padding: var(--section-padding-top) var(--section-padding-right-left) var(--section-padding-bottom);
		background: #fff;
		text-align: center;
		position: relative;
		z-index: 1;
	}

	.features {
		margin: 50px auto 20px auto;
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 35px;
		max-width: 940px;
	}

	.feature {
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.25) 0%, rgba(206, 228, 251, 0.25) 100%);
		border-radius: 15px;
		box-shadow: 0px 10px 20px 0px #2183ed26;
		border: 1px solid rgba(33, 131, 237, 0.15);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center; /* Center content vertically */
		padding: 20px;
		aspect-ratio: 1 / 1; /* Force square shape globally */
	}
	.feature p {
		font-weight: 500;
		font-size: 16px;
		line-height: 140%;
		letter-spacing: 0%;
		text-align: center;
		color: #3f3f3f;
		max-width: 120px;
		margin: 0 auto;
	}
	.feature img {
		margin-bottom: 10px;
		width: 40px;
		height: 40px;
	}

	/* Carousel */
	.carousel {
		position: relative;
		height: 320px;
		display: flex;
		justify-content: center;
		align-items: center;
		margin-bottom: 60px;
	}

	/* Video wrapper */
	.video-wrapper {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 20px;
		display: flex;
		justify-content: center;
	}

	/* Responsive video */
	.concepts-video {
		width: 100%;
		/* max-width: 899px; */
		height: auto;
		border-radius: 24px;
		object-fit: contain;
	}

	/* Tablet */
	@media (max-width: 900px) {
		.concepts-video {
			max-width: 100%;
			border-radius: 18px;
		}
	}

	/* Mobile */
	@media (max-width: 768px) {
		.video-wrapper {
			/* display: none; */
			padding: 0;
			margin-left: -20px;
			margin-right: -20px;
			width: calc(100% + 40px);
			max-width: calc(100% + 40px);
		}
		.concepts-video {
			border-radius: 0;
			width: 100%;
			max-width: 100%;
			outline: 5px solid white;
			outline-offset: -5px;
		}
	}

	/* Questions */
	.questions-slider {
		max-width: 100%;
		overflow-x: auto;
		margin: 0px auto;
		padding-bottom: 60px;
		scroll-snap-type: x mandatory;
	}

	.questions-slider::-webkit-scrollbar {
		display: none;
	}
	.questions-slider {
		-ms-overflow-style: none;
		scrollbar-width: none;
		/* Feathering edges with mask-image */
		mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
		-webkit-mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
	}

	/* Slider row */
	.questions {
		display: flex;
		gap: 22px;
		width: max-content;
		padding: 0 20px;
	}

	/* Bubble */
	.questions span {
		scroll-snap-align: center;
		flex: 0 0 auto;
		position: relative;
		display: flex;
		align-items: center;
		gap: 12px;
		width: 240px;
		text-align: left;
		background: #f8f7f4;
		border: 0.5px solid #b4b7b7;
		border-radius: 25px;
		padding: 14px 24px;

		font-size: 15px;
		line-height: 1.35;
		color: #000;

		box-shadow: 0px 20px 40px 0px #8c8c8c36;
	}

	/* Icon */
	.questions span img {
		width: 25px;
		height: auto;
		flex-shrink: 0;
	}
	@keyframes autoSlide {
		0% {
			transform: translateX(0);
		}
		100% {
			transform: translateX(-50%);
		}
	}

	.questions {
		animation: autoSlide 60s linear infinite;
	}

	.questions-slider:hover .questions {
		animation-play-state: paused;
	}

	/* ============================= */
	/* ODD — LEFT CURVED TAIL */
	/* ============================= */
	.questions span:nth-child(odd)::before {
		content: "";
		position: absolute;
		left: 25px;
		bottom: -18.4px;

		width: 23px;
		height: 18px;

		background: #f8f7f4;
		border-right: 0.5px solid #b4b7b7;
		border-left: 0.5px solid #b4b7b7;
		border-bottom: 0.5px solid #b4b7b7;

		border-radius: 0 0 100% 0;

		transform: rotate(0deg);
	}

	/* ============================= */
	/* EVEN — RIGHT CURVED TAIL */
	/* ============================= */
	.questions span:nth-child(even)::before {
		content: "";
		position: absolute;
		right: 25px;
		bottom: -18.4px;

		width: 23px;
		height: 18px;

		background: #f8f7f4;
		border-right: 0.5px solid #b4b7b7;
		border-left: 0.5px solid #b4b7b7;
		border-bottom: 0.5px solid #b4b7b7;
		border-radius: 0 0 0 100%;
		box-shadow: 6px 8px 18px rgba(0, 0, 0, 0.06);

		transform: rotate(0deg);
	}

	/* Tablet */
	@media (max-width: 900px) {
		.questions span {
			font-size: 14px;
			padding: 12px 20px;
		}
	}

	/* Mobile – center tail */
	@media (max-width: 600px) {
		.questions span {
			white-space: normal;
			max-width: 100%;
		}

		/* Reset centering and use specific positioning for odd/even */
		.questions span::before {
			left: auto !important;
			right: auto !important;
			transform: none !important;
			border-radius: 0 !important;
		}

		/* Restore odd/even specific styles if needed, or keep them as defined above */
		/* The previous mobile style forced centering which broke the design. 
           By resetting, we fall back to the odd/even styles which work. 
           We just need to ensure the border-radius matches the direction. */

		.questions span:nth-child(odd)::before {
			left: 25px !important;
			border-radius: 0 0 100% 0 !important;
		}

		.questions span:nth-child(even)::before {
			right: 25px !important;
			border-radius: 0 0 0 100% !important;
		}
	}

	/* CTA */
	.cta button {
		background: #2183ed;
		color: #fff;
		padding: 14px 36px;
		border-radius: 30px;
		border: none;

		font-weight: 400;
		font-size: 16px;
		line-height: 140%;
		letter-spacing: -0.5%;
		cursor: pointer;
	}
	.cta button:hover {
		background: #1558d6;
	}

	/* Responsive */
	@media (max-width: 900px) {
		.features {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 20px;
		}

		.feature {
			flex: 0 0 160px; /* Fixed width, no growing */
			width: 160px;
			max-width: 160px; /* strict limit */
			aspect-ratio: 1 / 1;
			padding: 20px; /* Keep padding consistent */
		}

		.carousel {
			height: 260px;
		}

		.card.left,
		.card.right {
			display: none;
		}
	}

	@media (max-width: 768) {
		.concepts-section {
			padding: 48px 0;
		}
		.questions-slider {
			margin-top: 2rem;
		}
	}

	@media (max-width: 768px) {
		.features {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 8px; /* Gap between items */
			margin: 30px auto 20px auto;
		}
		.feature {
			/* Exact width for 3 items: (100% - 2 * gap) / 3 */
			flex: 0 0 calc(33.33% - 30px);
			width: calc(33.33% - 6px);
			min-width: unset;
			padding: 10px 4px !important;

			/* Force square */
			aspect-ratio: 1 / 1;
			/* Ensure content is centered */
			justify-content: center;
		}
		.feature p {
			font-size: 11px !important; /* Slightly smaller to fit */
			line-height: 1.1;
			margin: 0; /* Remove potential default margins */
		}
		.feature img {
			width: 24px;
			height: 24px;
			margin-bottom: 4px;
		}
	}
</style>
<section class="concepts-section">
	<div class="container">
		<!-- Heading -->
		<div class="heading">
			<h2 set:html={heading} />
			<p>{subheading}</p>
		</div>

		<!-- Feature icons -->
		<div class="features">
			{
				featuresList.map(feature => (
					<div class="feature">
						<Image src={iconMap[feature.icon] || conceptsSectionIcon1} alt={feature.text} />
						<p>{feature.text}</p>
					</div>
				))
			}
		</div>

		<!-- 3D Video -->
		<div class="video-wrapper">
			<video class="concepts-video" autoplay muted loop playsinline data-speed={videoPlaybackSpeed}>
				<source src={mobileVideoSrc} type="video/webm" media="(max-width: 768px)" />
				<source src={videoSrc} type="video/webm" />
				Your browser does not support the video tag.
			</video>
		</div>

		<script>
			document.addEventListener("DOMContentLoaded", () => {
				const videos = document.querySelectorAll("video.concepts-video");
				videos.forEach(vid => {
					const videoEl = vid as HTMLVideoElement;
					const speed = parseFloat(videoEl.dataset.speed || "1.0");
					videoEl.playbackRate = speed;
				});
			});
		</script>

		<!-- Question slider -->
		<div class="questions-slider">
			<div class="questions-track">
				<div class="questions">
					{/* Use props for questions */}
					{
						questionsList && questionsList.length > 0 ? (
							<>
								{questionsList.map(q => (
									<span>
										<Image src={q.icon} alt="Question Icon" />
										{q.text}
									</span>
								))}
								{/* Duplicate for loop */}
								{questionsList.map(q => (
									<span>
										<Image src={q.icon} alt="Question Icon" />
										{q.text}
									</span>
								))}
							</>
						) : (
							/* Fallback or empty if needed, but data should be there */
							<span>No questions available</span>
						)
					}
				</div>
			</div>
		</div>

		<!-- CTA -->
		<div class="cta">
			<button onclick="window.openZohoModal && window.openZohoModal()">Explore More</button>
		</div>
	</div>
</section>

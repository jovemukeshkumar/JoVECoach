---
import { Image } from "astro:assets";
import aiChatIcon from "../../assets/ai-chat-icon.svg";
import ZohoDummyForm from "../../components/ZohoDummyForm.astro";

interface Props {
	title?: string;
	subtitle?: string;
	ctaText?: string;
	formSource?: string;
	redirectPath?: string;
	redirectUri?: string;
}

const { title = "Stuck on a concept right now?", subtitle = "See how JoVE Coach explains it clearly - with AI.", ctaText = "Start My Free Trial", formSource = "first-cta", redirectPath, redirectUri } = Astro.props;
---

<style>
	#Last_Name_cta1 {
		padding: 0 15px;
	}
	.ai-cta-section {
		padding: 4rem 1rem 3rem 1rem;
		/* margin-bottom: -100px; */
		position: relative;
		z-index: 10;
	}

	.ai-cta-section::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 40%;
		background-image: linear-gradient(to bottom, rgba(227, 237, 255, 0.5) 0%, rgba(227, 237, 255, 0) 100%);
		pointer-events: none;
		z-index: 0;
	}

	.ai-cta-card {
		max-width: var(--cta-width);
		max-height: 280px;
		margin: 0 auto;
		background: #f8f7f4; /* solid base */
		border-radius: 20px;
		padding: 2rem 4rem;
		display: grid;
		grid-template-columns: 1.05fr 1.3fr 0.85fr;
		align-items: center;
		gap: 2rem;
		position: relative;
		z-index: 10;
		box-shadow: 0px 10px 40px rgba(0, 0, 0, 0.25);
		overflow: hidden; /* clip pseudo-element */
	}
	.ai-cta-card::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 0;

		background-image: url("../../assets/aiChatBg.png");
		background-size: contain;
		background-position: right -300px center;
		background-repeat: no-repeat;

		pointer-events: none;
	}
	.ai-cta-card > * {
		position: relative;
		z-index: 1;
	}

	.ai-cta-content {
		max-width: 445px;
		height: 180px;
	}
	/* Left text */
	.ai-cta-content h3 {
		color: #000;
		margin: 0;
	}

	.ai-cta-content p {
		font-weight: 400;
		font-size: 18px;
		line-height: 140%;
		letter-spacing: 0%;
		max-width: 300px;
		color: #000;
	}

	.ai-cta-btn {
		background: #2183ed;
		color: #fff;
		border: none;
		padding: 12px 20px;
		border-radius: 30px;

		font-weight: 500;
		font-size: 18px;
		line-height: 28px;
		letter-spacing: 0%;
		text-align: center;
		cursor: pointer;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	.ai-cta-btn:hover {
		transform: translateY(-2px);
		box-shadow: 0 10px 25px rgba(33, 131, 237, 0.35);
	}

	/* Center icon */
	.ai-cta-icon {
		display: flex;
		justify-content: end;
	}

	.ai-cta-icon img {
		width: 100%;
		max-width: 200px; /* Reduced max-width to fit smaller column */
		height: auto;
	}

	/* Center form */
	.ai-cta-form {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		width: 100%;
		max-width: 480px;
	}

	.ai-cta-form input {
		width: 100%;
		padding: 14px 16px;
		border-radius: 10px;
		border: 2px solid #eeeeee;
		font-size: 15px;
		outline: none;

		font-weight: 400;
		font-size: 16px;
		line-height: 140%;
		letter-spacing: 0%;
	}

	.ai-cta-form input:focus {
		border-color: #2183ed;
	}

	.ai-cta-form :global(.name-field) {
		border-radius: 8px 0 0 8px;
		border-right: none;
	}

	.ai-cta-form :global(.email-field) {
		border-radius: 0 8px 8px 0;
	}

	.ai-cta-form :global(.company-field) {
		border-radius: 8px;
	}

	@media (max-width: 768px) {
		.ai-cta-form :global(.name-field),
		.ai-cta-form :global(.email-field) {
			border-radius: 8px !important;
			border-right: 2px solid #eeeeee;
		}
	}

	/* Override button color for this section */
	.ai-cta-form :global(.global-form-btn) {
		background-color: var(--primary-color) !important;
		color: white !important;
		border: none !important;
	}

	.ai-cta-form :global(.global-form-btn:hover) {
		background-color: #1a6bbf !important;
	}

	/* ---------- Responsive ---------- */

	@media (max-width: 992px) {
		.ai-cta-card {
			display: grid;
			grid-template-columns: 1fr 1fr; /* layout becomes 2 columns: Text | Form */
			gap: 2rem;
			padding: 2rem;
			text-align: left; /* Align text left for better readability side-by-side */
			height: auto;
			max-height: none;
		}

		.ai-cta-content {
			min-width: 0;
			width: 100%;
			height: auto;
		}

		.ai-cta-icon {
			display: none; /* Hide icon as per previous login, or keep if grid allows. User complaints implies 2 columns is "issue" or maybe "3 columns and now 2" implies they want 3? No, they said "flex is causing issues". Grid 2 is safer than Flex Column at 990. */
		}

		.ai-cta-form {
			width: 100%;
			max-width: 100%;
			align-items: flex-start; /* Align form left */
		}

		.ai-cta-form input {
			min-width: 0;
		}

		.ai-cta-btn {
			max-width: 100%;
			width: 100%;
		}
	}

	@media (max-width: 768px) {
		.ai-cta-card {
			display: flex;
			flex-direction: column;
			gap: 2rem !important; /* Restore gap for stacking */
			text-align: center; /* Center text on mobile */
		}

		.ai-cta-content p {
			max-width: unset;
		}

		.ai-cta-form {
			align-items: center; /* Center form on mobile */
			width: 100%;
			max-width: 400px;
			margin: 0 auto;
		}
	}

	@media (max-width: 480px) {
		.ai-cta-content h3 {
			font-size: 22px;
		}

		.ai-cta-content p {
			font-size: 14px;
		}

		.ai-cta-btn {
			width: 100%;
		}
	}
</style>
<section class="ai-cta-section">
	<div class="ai-cta-card">
		<!-- Left content -->
		<div class="ai-cta-content">
			<h3 set:html={title} />
			<p>{subtitle}</p>
		</div>

		<!-- Right form -->
		<div class="ai-cta-form">
			<ZohoDummyForm layout="vertical" formIdSuffix="cta1" ctaText={ctaText} buttonLayout="inline" formSource={formSource} redirectPath={redirectPath} redirectUri={redirectUri} />
		</div>

		<!-- Center icon -->
		<div class="ai-cta-icon">
			<Image src={aiChatIcon} alt="AI Chat Icon" />
		</div>
	</div>
</section>

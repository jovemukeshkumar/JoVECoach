---
import { Image, getImage } from "astro:assets";
// BG Images remain hardcoded/generic for now, or could be passed. Let's keep them here as they are styling.
import JoVECoachStepsBgImage1 from "../../assets/JoVECoachStepsBgImage1.webp";
import JoVECoachStepsBgImage2 from "../../assets/JoVECoachStepsBgImage2.webp";

const optimizedBg1 = await getImage({ src: JoVECoachStepsBgImage1, format: "webp" });
const optimizedBg2 = await getImage({ src: JoVECoachStepsBgImage2, format: "webp" });

interface Step {
	id: string;
	icon: ImageMetadata;
	title: string;
	number: string;
	headline: string;
	description: string;
	image: ImageMetadata | string;
}

interface Props {
	steps: Step[];
	title?: string;
	subtitle?: string;
	discoverText?: string;
}

const { steps, title = 'JoVE Coach is more than a study tool - <br /> <span class="highlight">it\'s that helps you finally get it.</span>', subtitle = "2-minute videos. AI-backed clarity. Instant practice.", discoverText = "Discover JoVE's 4 steps to Mastery." } = Astro.props;

const isVideo = (file: any) => typeof file === "string" && /\.(mp4|webm|ogg|mov|m4v)$/i.test(file);
---

<style>
	.jove-coach-section {
		position: relative;
		z-index: 1;
		background-color: #fff; /* Ensure background is opaque */
		padding-top: 50px; /* Added spacing from previous section */
		/* padding-bottom: 50px; */
	}

	/* Scroll Track for Desktop */
	.scroll-track {
		height: 400vh; /* 100vh per step roughly */
		position: relative;
	}

	/* Sticky Wrapper */
	.sticky-wrapper {
		position: sticky;
		top: 60px;
		height: calc(100vh - 40px);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow-y: auto; /* Allow scrolling if content is taller than viewport */
		overflow-x: hidden;
		padding: 0rem 1.5rem 2rem 1.5rem; /* Reduced top padding from 2rem to 0 */
		box-sizing: border-box;
		z-index: 10;
	}

	@media (max-height: 800px) {
		.sticky-wrapper {
			align-items: flex-start; /* Start from top on shorter screens */
			padding-top: 1rem;
		}
	}

	/* Grid Background on Sticky Wrapper */
	.sticky-wrapper::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;

		background-image: url("../../assets/JoVECoachStepsBgGrid.svg"), url("../../assets/JoVECoachStepsBgGrid.svg");

		background-repeat: no-repeat, no-repeat;
		background-position:
			1100px top,
			540px bottom; /* Moved left by 60px */
		background-size:
			auto 300px,
			auto 300px;

		opacity: 0.25;
	}

	.jove-coach-section::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 0 !important;
		pointer-events: none;

		background-image: var(--bg-image-1), var(--bg-image-2);

		background-repeat: no-repeat, no-repeat;
		background-position:
			center top,
			center bottom;
		background-size: contain, contain;
	}

	.container {
		max-width: 1320px;
		margin: 0 auto;
		position: relative;
		z-index: 10;
		width: 100%;
	}

	.header-content {
		text-align: center;
		margin-bottom: 2rem;
	}

	.static-header {
		padding-top: 2.5rem;
		margin-bottom: 0rem; /* Reduced from 1rem */
	}

	.sticky-header-content {
		padding-top: 0;
		margin-bottom: 0rem; /* Reduced from 1rem */
	}

	.header-content h2 :global(span) {
		display: block;
	}

	.subtitle {
		font-weight: 400;
		font-size: 18px;
		line-height: 25.2px;
		letter-spacing: 0%;
		text-align: center;
		color: #3f3f3f;
		max-width: 470px;
		margin: 0 auto;
	}

	.discover-text {
		font-weight: 500;
		font-size: 18px;
		line-height: 25.2px;
		letter-spacing: 0%;
		text-align: center;
		margin: 10px 0px 20px 0px;
		color: #000;
	}

	/* Tabs */
	.tabs-container {
		display: flex;
		justify-content: space-evenly;
		gap: 2rem;
		flex-wrap: wrap;
		margin: 2rem auto;
		padding: 15px 20px;
		border-radius: 15px;
		max-width: 750px;
		background: linear-gradient(103.67deg, rgba(204, 227, 251, 0.05) 4.03%, rgba(33, 131, 237, 0.07) 147.63%);
		box-sizing: border-box;
	}

	.tab-button {
		display: flex;
		align-items: center;
		padding: 0.75rem 1.5rem;
		background: transparent;
		border-radius: 15px;

		font-weight: 500;
		font-size: 20px;
		line-height: 140%;
		letter-spacing: 0%;
		text-align: center;
		cursor: pointer;
		transition: all 0.3s ease;
		border: transparent;
	}

	.tab-button:hover {
		border: 1px solid #2183ed80;
		color: #2183ed;
		box-shadow: 0 4px 12px rgba(43, 156, 235, 0.15);
	}

	.tab-button.active {
		border: 1px solid #2183ed80;
		color: #2183ed;
		box-shadow: 0px 11px 15px 0px #0000000d;
	}

	.tab-icon {
		width: 20px;
		height: auto;
		margin-bottom: -2px;
	}

	/* Make active tab icons appear blue */
	.tab-button:hover .tab-icon,
	.tab-button.active .tab-icon {
		filter: grayscale(0) sepia(1) saturate(8) hue-rotate(180deg) brightness(1.05);
	}

	/* Steps Content */
	.steps-wrapper {
		position: relative;
		min-height: 500px;
	}

	.step-content {
		display: none;
		animation: fadeIn 0.5s ease-in-out;
	}

	.step-content.active {
		display: block;
	}

	@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.content-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: center;
		max-width: 750px;
		min-height: 400px;
		margin: 0 auto;
		padding: 0;
		position: relative;
		z-index: 10;
	}

	.step-visual {
		position: relative;
	}

	.mockup-container {
		position: relative;
		border-radius: 16px;
		overflow: hidden;
		background: white;
	}

	.mockup-image {
		width: 90%;
		height: 100%;
		display: block;
		border-radius: 12px;
		object-fit: cover;
	}
	.tab-title {
		margin-left: 0.75rem;

		font-weight: 500;
		font-size: 20px;
		line-height: 140%;
		letter-spacing: 0%;
		text-align: center;
	}
	.step-info {
		padding: 1rem;
	}

	.step-number {
		display: inline-block; /* Fix overlap issue */
		margin-bottom: 15px;
		font-weight: 500;
		font-size: 18px;
		line-height: 140%;
		letter-spacing: -1%;
		color: #000;
		border: 0.5px solid #2183ed;
		border-radius: 100px;
		padding: 5px 20px;
	}

	.step-headline {
		font-weight: 500;
		font-size: 20px;
		line-height: 140%;
		letter-spacing: 0%;
		color: #2183ed;
		min-width: 350px;
	}

	.step-description {
		font-weight: 400;
		font-size: 16px;
		line-height: 140%;
		letter-spacing: 0%;
		color: #3f3f3f;
		max-width: 300px;
	}

	.mockup-container video {
		width: 100%;
		display: block;
		object-fit: contain;
		min-width: 400px;
		height: 385px;
	}
	.mockup-container img {
		width: 100%;
		height: auto;
		object-fit: cover;
	}
	.image-wrapper {
		display: flex;
		justify-content: center;
		align-items: center;
		padding: 10px;
		background: url("../../assets/Jove_chat_bg.png");
		background-size: cover;
		background-position: center;
		border-radius: 16px;
		overflow: hidden;
		min-width: 400px;
		min-height: 385px;
		z-index: 10;
		box-sizing: border-box;
	}

	.image-wrapper picture,
	.image-wrapper img,
	.image-wrapper .mockup-image {
		border-radius: 17px;
		display: block;
		width: 90%;
		height: 100%;
		object-fit: cover;
	}

	/* Responsive Design */
	@media (max-width: 968px) {
		.step-description {
			margin: 0 auto;
			max-width: unset !important;
		}
		.content-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
			padding: 2rem;
		}

		.step-visual {
			order: 2;
		}

		.step-info {
			order: 1;
			text-align: center;
		}
	}

	@media (max-width: 768px) {
		/* Disable scroll pinning on mobile */
		/* .scroll-track {
			padding-top: 2rem;
		} */

		.header-content.static-header {
			margin-bottom: 0.5rem;
			padding-top: 2rem; /* Reduced padding on mobile */
		}

		.header-content.sticky-header-content {
			margin-bottom: 1rem;
			padding-top: 0;
		}
		.content-grid {
			max-height: unset;
		}

		.jove-coach-section {
			padding: 0; /* Wrapper padding handled by sticky-wrapper override */
		}

		.main-title {
			font-size: 1.75rem;
		}

		.subtitle {
			font-size: 1rem;
		}

		.subtitle br {
			display: none;
		}

		.tabs-container {
			gap: 0.5rem;
		}

		.tab-button {
			padding: 0.625rem 1rem;
			font-size: 0.875rem;
		}

		.sticky-wrapper {
			justify-content: flex-start;
			align-items: stretch;
			overflow-y: auto; /* Allow internal scroll if content is too tall */
			padding: 1rem 0; /* Reduced padding */
		}
		.tab-title {
			font-size: 18px;
		}

		.step-description {
			font-size: 14px;
			margin: 0 auto;
		}
		.step-number {
			display: none;
		}
	}

	@media (max-width: 480px) {
		.main-title {
			font-size: 1.5rem;
		}

		.main-title :global(br) {
			display: none;
		}

		.header-content h2 :global(span) {
			display: inline;
		}

		.tabs-container {
			flex-direction: row;
			flex-wrap: nowrap;
			align-items: center;
			justify-content: space-between;
			gap: 2px;
			margin: 0;
			padding: 10px;
		}
		.discover-text {
			font-size: 14px;
			font-weight: 400;
		}
		.tab-button {
			justify-content: center;
			flex: 1;
			padding: 6px 1px;
			font-size: 12px;
			min-width: 0; /* Allow shrinking */
			gap: 2px; /* Icon gap */
		}

		.tab-icon {
			width: 16px;
			height: auto;
		}

		.tab-title {
			font-size: 12px;
			margin-left: 2px;
		}

		/* Resize Practise icon specifically (0.8x) */
		.tab-button[data-step="practise"] .tab-icon {
			width: 13px;
		}

		.content-grid {
			padding: 0;
			gap: 1.5rem;
		}

		.step-info {
			display: flex;
			flex-direction: column;
			align-items: center;
			text-align: center;
			padding: 0 1.5rem;
		}

		.step-headline {
			min-width: 0;
			width: 100%;
			margin-bottom: 0;
		}

		.step-visual {
			width: 100%;
			margin: 0;
		}

		.mockup-container,
		.image-wrapper,
		.mockup-container video {
			min-width: 0;
			width: 100%;
			height: auto;
			min-height: 0;
			border-radius: 0;
		}

		.image-wrapper {
			border-radius: 0;
		}
	}
</style>

<section class="jove-coach-section" style={`--bg-image-1: url(${optimizedBg1.src}); --bg-image-2: url(${optimizedBg2.src});`}>
	<!-- Main header moved inside sticky wrapper -->

	<div class="scroll-track">
		<div class="sticky-wrapper">
			<div class="container">
				<!-- Header -->
				<div class="header-content sticky-header-content">
					<h2 set:html={title} />
					<p class="discover-text">{discoverText}</p>

					<!-- Navigation Tabs -->
					<div class="tabs-container">
						{
							steps.map(step => (
								<button class="tab-button" data-step={step.id} aria-label={`View ${step.title} step`}>
									<Image src={step?.icon} alt={step.title} class="tab-icon" loading="lazy" />
									<span class="tab-title">{step.title}</span>
								</button>
							))
						}
					</div>
				</div>

				<!-- Steps Content -->
				<div class="steps-wrapper">
					{
						steps.map((step, index) => (
							<div class={`step-content ${index === 0 ? "active" : ""}`} data-step={step.id}>
								<div class={`content-grid bg-gradient-to-br`}>
									<div class="step-visual">
										<div class="mockup-container">
											{isVideo(step.image) ? (
												<video class="mockup-image" autoplay muted loop playsinline preload="metadata">
													<source src={step.image as string} />
													Your browser does not support the video tag.
												</video>
											) : (
												<div class="image-wrapper">
													<Image src={step.image as ImageMetadata} alt={step.title} class="mockup-image" inferSize />
												</div>
											)}
										</div>
									</div>

									<div class="step-info">
										<span class="step-number">{step.number}</span>
										<h3 class="step-headline">{step.headline}</h3>
										<p class="step-description">{step.description}</p>
									</div>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	// Tab switching functionality
	document.addEventListener("DOMContentLoaded", () => {
		const tabButtons = document.querySelectorAll(".tab-button");
		const stepContents = document.querySelectorAll(".step-content");
		const track = document.querySelector(".scroll-track");
		const stepsCount = tabButtons.length;

		// Helper function to check if a file is a video
		const isVideo = (file: any) => typeof file === "string" && /\.(mp4|webm|ogg|mov|m4v)$/i.test(file);

		// Function to activate a specific tab
		function activateTab(index: number) {
			if (index < 0 || index >= stepsCount) return;

			// Remove active class from all
			tabButtons.forEach(btn => btn.classList.remove("active"));
			stepContents.forEach(content => content.classList.remove("active"));

			// Add active class to current
			tabButtons[index].classList.add("active");
			const stepId = tabButtons[index].getAttribute("data-step");
			const activeContent = document.querySelector(`.step-content[data-step="${stepId}"]`);
			if (activeContent) {
				activeContent.classList.add("active");
			}
		}

		// Click Handler (Manual Override)
		tabButtons.forEach((button, index) => {
			button.addEventListener("click", () => {
				activateTab(index);
				// Optional: Scroll to the corresponding section of the track if we want to sync scroll position
				// But for now, just switching content is fine.
			});
		});

		// Scroll Handler
		window.addEventListener("scroll", () => {
			if (!track) return;

			const rect = track.getBoundingClientRect();
			const trackHeight = rect.height - window.innerHeight;
			const scrolled = -rect.top; // Pixels scrolled into the track

			// If we are within the scroll track
			if (scrolled >= 0 && scrolled <= trackHeight) {
				const progress = scrolled / trackHeight;
				// Map progress (0 to 1) to step index (0 to 3)
				// We want to switch slightly earlier than the exact division to feel responsive
				const stepIndex = Math.min(Math.floor(progress * stepsCount), stepsCount - 1);
				activateTab(stepIndex);
			}
		});

		// Set first tab as active by default
		if (tabButtons.length > 0) {
			activateTab(0);
		}
	});
</script>

---
import qs from "qs";
import mostPopular from "../../assets/mostPopular.svg";
import pricecut from "../../assets/pricecut.svg";
import priceDiscountIcon from "../../assets/priceDiscountIcon.png";
import { Image } from "astro:assets";

// Strapi v5 syntax - use `on` for dynamic zone components
const aboutPageQuery = qs.stringify(
	{
		populate: {
			pricingSection: {
				on: {
					"layout.price-details-section": {
						populate: {
							pricingSection: {
								populate: {
									featuresListText: { populate: "*" },
								},
							},
						},
					},
				},
			},
		},
	},
	{ encodeValuesOnly: true },
);

// Reusable safe fetch
async function getStrapiData(path: string) {
	try {
		const BASE_URL = import.meta.env.PUBLIC_BACKEND_URL;
		if (!BASE_URL) return null;

		const url = new URL(path, BASE_URL);
		url.search = aboutPageQuery;

		const res = await fetch(url.href);
		if (!res.ok) return null;

		const json = await res.json();
		return json?.data ?? null;
	} catch (err) {
		console.error("Strapi pricing fetch error:", err);
		return null;
	}
}

const data = await getStrapiData("/api/pricing-page");

// Safely extract pricing component
const priceDetailsSection = data?.pricingSection?.find((b: any) => b.__component === "layout.price-details-section") ?? {};

// Pricing plans (always an array)
const pricingPlans = priceDetailsSection?.pricingSection ?? [];
---

<style>
	/* Layout */
	.pricing-section {
		width: 100%;
		height: auto;
	}

	.pricing-container {
		width: 100%;
		height: 100%;
		padding-top: 74px;
		padding-bottom: 108px;
		position: relative;
		z-index: 2;
		overflow: hidden;
	}

	/* Titles */
	.pricing-title {
		color: #000;
		text-align: center;

		font-size: 46px;
		font-weight: 600;
		line-height: 120%;
		letter-spacing: -0.46px;
		max-width: 570px;
		margin: 0 auto;
	}

	.pricing-subtitle {
		text-align: center;
		margin: 16px 0 38px;

		font-size: 18px;
		font-weight: 400;
		line-height: 140%;
		color: #3f3f3f;
	}

	/* Grid */
	.pricing-row {
		margin-left: -16px;
		margin-right: -16px;
		margin-top: 24px;
		display: flex;
		justify-content: center;
	}

	.pricing-col {
		padding-left: 16px;
		padding-right: 16px;
		width: 406px;
		cursor: pointer;
		position: relative;
	}

	/* Popular badge */
	.popular-badge {
		position: relative;
		top: 4px;
		margin-left: 29px;
	}

	/* Card Styles */
	.pricing-card {
		border: 2px solid rgb(217, 217, 217);
		border-radius: 24px;
		box-shadow: rgba(0, 0, 0, 0.05) 0px 0px 8px;
		margin: 0px;
		padding: 24px 28px;
		max-width: 374px;
	}
	.pricing-card.selected {
		border: 2px solid rgb(22, 119, 255) !important;
		box-shadow: 0px 0px 12px rgba(22, 119, 255, 0.25);
	}

	.featured-card {
		border: 2px solid rgb(217, 217, 217);
		max-width: 375px;
	}

	.basic-card {
		border: 2px solid rgb(217, 217, 217);
		margin-top: 30px !important;
		max-width: 305px;
	}

	.pricing-card-body {
		padding: 0;
		max-width: 315px;
		min-height: 313px;
	}

	.pricing-header {
		margin-bottom: 15px;
	}

	/* Row with label + tag */
	.pricing-label-row {
		display: flex;
		align-items: center;
	}

	/* Plan type */
	.plan-type {
		font-weight: 600;
		font-size: 22px;
		color: #000;
		text-align: left;
		margin-bottom: 24px;
	}

	/* Discount badge */
	.discount-tag {
		background-color: rgb(139, 255, 174);
		margin-top: 7px;
		display: flex;
		justify-content: center;
		align-items: center;
		height: 24px;
		width: 103px;
		margin-left: 12px;
		border-radius: 50px;
	}

	.discount-icon {
		height: 16px;
		width: 16px;
	}

	.discount-text {
		color: #000;
		margin-left: 6px;
	}

	/* Pricing text */
	.price-text {
		text-align: left;

		font-weight: 600;
		font-size: 28px;
		margin: 0px 0px 12px 0px;
	}

	/* Pricecut image */
	.pricecut-img {
		width: auto;
		height: auto;
	}

	/* Divider */
	.card-divider {
		margin: 24px 0;
		border: 0.5px solid #d9d9d9;
		width: 100%;
	}

	/* Feature List */
	.feature-list {
		text-align: left;
		padding: 0;
		list-style: none;
		margin: 0;
	}

	.feature-item {
		font-size: 15px;
		display: flex;
		align-items: center;
		margin-bottom: 10px;
	}

	.feature-dot {
		display: inline-block;
		width: 8px;
		height: 8px;
		background-color: rgb(33, 131, 237);
		margin-right: 12px;
		border-radius: 2px;
	}

	/* Buttons */
	.button-row {
		text-align: center;
	}

	.primary-btn {
		width: 100%;
		height: 56px;
		margin-top: 14px;
		background-color: rgb(33, 131, 237);
		color: white;
		font-size: 16px;
		font-weight: 700;

		border-radius: 100px;
		padding: 13px 24px;
		border: none;
	}
</style>

<section class="pricing-section">
	<div class="pricing-container">
		<p class="pricing-title">
			{priceDetailsSection?.title ?? "Pricing"}
		</p>

		<p class="pricing-subtitle">
			{priceDetailsSection?.subTitle ?? ""}
		</p>

		<div class="pricing-row ant-row ant-row-center css-vrrzze">
			{pricingPlans.length === 0 && <p style="text-align:center; color:#777;">Pricing details will be updated soon.</p>}

			{
				pricingPlans.map((plan: any) => (
					<div class="pricing-col">
						{plan?.tag && plan.tag !== "NA" && <Image src={mostPopular} alt="Popular" class="popular-badge" />}

						<div class={`pricing-card ${plan?.tag && plan.tag !== "NA" ? "featured-card selected" : "basic-card"}`} data-card={plan?.title?.toLowerCase() ?? ""}>
							<div class="ant-card-body pricing-card-body">
								<div class="pricing-header">
									<div class="pricing-label-row">
										<p class="plan-type">{plan?.title ?? ""}</p>

										{plan?.tag && plan.tag !== "NA" && (
											<span class="discount-tag">
												<Image src={priceDiscountIcon} alt="" class="discount-icon" />
												<span class="discount-text">{plan.tag}</span>
											</span>
										)}
									</div>

									<h3 class="price-text">{plan?.price ?? ""}</h3>
								</div>

								{plan?.oldPrice && plan.oldPrice !== "NA" && <Image src={pricecut} alt="Pricecut" class="pricecut-img" />}

								<hr class="card-divider" />

								<ul class="feature-list">
									{plan?.featuresListText?.map((item: any) => (
										<li class="feature-item">
											<span class="feature-dot" />
											{item?.listText ?? ""}
										</li>
									))}
								</ul>

								<div class="button-row">
									<button class="primary-btn ant-btn ant-btn-default">
										<span>{plan?.buttonText ?? "Select"}</span>
									</button>
								</div>
							</div>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		const cards = document.querySelectorAll(".pricing-card");

		cards.forEach(card => {
			card.addEventListener("click", () => {
				cards.forEach(c => c.classList.remove("selected"));
				card.classList.add("selected");
			});
		});
	});
</script>

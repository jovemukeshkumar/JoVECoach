<style>
  /* Base Styles */
  #crmWebToEntityForm.zcwf_lblLeft {
    margin: 50px auto;
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    max-width: 1080px !important;
    display: flex !important;
    justify-content: flex-start !important;
    flex-direction: column !important;
    color: #fff !important;
    background: rgb(33, 131, 237) !important;
    border-radius: 8px !important;
    padding: 60px 70px !important;
    position: relative !important;
    background-image: url('../assets/section11Card.svg') !important;
    background-position: right center !important;
    background-repeat: no-repeat !important;
    background-size: contain !important;
    
  }
  #crmWebToEntityForm.zcwf_lblLeft * {
    box-sizing: border-box;
  }
  #crmWebToEntityForm {
    text-align: left;
  }
  #crmWebToEntityForm * {
    direction: ltr;
  }
  .zcwf_lblLeft .zcwf_title {
    word-wrap: break-word;
    padding: 0px 6px 10px;
    margin-bottom: 12px;
    color: #fff !important;
    font-family: Inter !important;
    font-weight: 600 !important;
    font-size: 32px !important;
    line-height: 120% !important;
    letter-spacing: -0.5px !important;
    vertical-align: middle;
  }
  .zcwf_subtitle {
    font-family: Inter !important;
    font-weight: 400 !important;
    font-size: 16px !important;
    line-height: 140% !important;
    letter-spacing: 0% !important;
    color: rgba(255, 255, 255, 0.9) !important;
    max-width: 500px;
    margin-bottom: 32px;
  }
  .zcwf_form_row {
    display: flex !important;
    gap: 16px !important;
    flex-wrap: wrap !important;
    margin: 0 !important;
    max-width: 520px !important;
  }
  .zcwf_input_group {
    flex: 1;
    /* min-width: 220px; */
    width: auto !important;
    float: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }
  .zcwf_lblLeft .zcwf_col_fld input[type=text], input[type=password], .zcwf_lblLeft .zcwf_col_fld textarea {
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.3) !important;
    resize: vertical;
    border-radius: 8px;
    float: none;
    padding: 12px 16px !important;
    background-color: rgba(255, 255, 255, 0.95) !important;
    color: #333 !important;
    font-size: 14px !important;
    font-family: Inter !important;
    transition: all 0.3s ease;
  }
  .zcwf_lblLeft .zcwf_col_fld input[type=text]::placeholder {
    color: #C8C1C1;
    font-family: Inter !important;
    font-weight: 400 !important;
    font-size: 18px !important;
    line-height: 140% !important;
    letter-spacing: 0% !important;
    vertical-align: middle;

  }
  .zcwf_lblLeft .zcwf_col_fld input[type=text]:focus {
    outline: none;
    border-color: rgba(255, 255, 255, 0.6) !important;
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.1);
  }
  .zcwf_lblLeft .zcwf_col_lab {
    display: none;
  }
  .zcwf_lblLeft .zcwf_col_fld {
    float: none;
    width: auto;
    padding: 0px;
    position: relative;
    margin-top: 0;
  }
  .zcwf_lblLeft .zcwf_privacy { padding: 6px; }
  .zcwf_lblLeft .wfrm_fld_dpNn { display: none; }
  .dIB { display: inline-block; }
  .zcwf_lblLeft .zcwf_col_fld_slt {
    width: 60%;
    border: 1px solid #ccc;
    background: #fff;
    border-radius: 4px;
    font-size: 12px;
    float: left;
    resize: vertical;
    padding: 2px 5px;
  }
  .zcwf_lblLeft .zcwf_row:after, .zcwf_lblLeft .zcwf_col_fld:after {
    content: '';
    display: table;
    clear: both;
  }
  .zcwf_lblLeft .zcwf_col_help {
    float: left;
    margin-left: 7px;
    font-size: 12px;
    max-width: 35%;
    word-break: break-word;
    display: none;
  }
  .zcwf_lblLeft .zcwf_help_icon {
    cursor: pointer;
    width: 16px;
    height: 16px;
    display: inline-block;
    background: #fff;
    border: 1px solid #c0c6cc;
    color: #c1c1c1;
    text-align: center;
    font-size: 11px;
    line-height: 16px;
    font-weight: bold;
    border-radius: 50%;
  }
  .zcwf_lblLeft .zcwf_row {
    margin: 0px 0px;
  }
  .zcwf_button_row {
    display: flex !important;
    gap: 12px !important;
    align-items: center !important;
    margin: 20px 0px 0px 0px !important;
  }
  .zcwf_lblLeft .formsubmit {
    margin-right: 0;
    cursor: pointer;
  }
  .formsubmit.zcwf_button {
    color: white !important;
    background: transparent !important;
    border: 1px solid white !important;
    padding: 12px 28px !important;
    border-radius: 50px !important;
    cursor: pointer !important;
    transition: all 0.3s ease !important;

    overflow: visible;
    text-overflow: unset;
    font-family: Inter  !important;
    font-weight: 500 !important;
    font-size: 18px !important;
    line-height: 28px !important;
    letter-spacing: 0% !important;
    text-align: center;
    vertical-align: middle;

  }
  .formsubmit.zcwf_button:hover {
    background: rgba(255, 255, 255, 0.15) !important;
    transform: translateY(-2px);
  }
  .formsubmit.zcwf_button:active {
    transform: translateY(0);
  }
  .formsubmit.zcwf_button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .zcwf_benefits {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
    font-family: Inter;
    margin-top: 20px;
  }
  /* Popup Styles */
  .wf_customMessageBox {
    font-family: Arial, Helvetica, sans-serif;
    color: #132C14;
    background: #F5FAF5;
    box-shadow: 0 2px 6px 0 rgba(0,0,0,0.25);
    max-width: 90%;
    width: max-content;
    word-break: break-word;
    z-index: 11000;
    border-radius: 6px;
    border: 1px solid #A9D3AB;
    min-width: 100px;
    padding: 10px 15px;
    display: flex;
    align-items: center;
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translate(-50%, 0);
  }
  .wf_customCircle {
    position: relative;
    background-color: #12AA67;
    border-radius: 100%;
    width: 20px;
    height: 20px;
    flex: none;
    margin-right: 7px;
  }
  .wf_customCheckMark {
    box-sizing: unset !important;
    position: absolute;
    transform: rotate(45deg) translate(-50%, -50%);
    left: 6px;
    top: 9px;
    height: 8px;
    width: 3px;
    border-bottom: 2px solid #fff;
    border-right: 2px solid #fff;
  }
  @media all and (max-width: 600px) {
    #crmWebToEntityForm.zcwf_lblLeft {
      padding: 40px 24px !important;
    }
    .zcwf_title {
      font-size: 24px !important;
      margin-bottom: 8px;
    }
    .zcwf_subtitle {
      font-size: 14px !important;
      margin-bottom: 24px;
    }
    .zcwf_form_row {
      flex-direction: column !important;
      gap: 12px !important;
    }
    .zcwf_input_group {
      min-width: unset;
    }
    .formsubmit.zcwf_button {
      min-width: 100%;
    }
  }
</style>

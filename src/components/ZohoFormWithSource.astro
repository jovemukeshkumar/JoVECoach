	<script is:inline>
		function validateEmail1127844000002481048() {
			var form = document.forms["WebToLeads1127844000002481048"];
			var emailFld = form.querySelectorAll('input[type="email"]');
			var i;
			for (i = 0; i < emailFld.length; i++) {
				var emailVal = emailFld[i].value;
				if (emailVal.replace(/^\s+|\s+$/g, "").length != 0) {
					var atpos = emailVal.indexOf("@");
					var dotpos = emailVal.lastIndexOf(".");
					if (atpos < 1 || dotpos < atpos + 2 || dotpos + 2 >= emailVal.length) {
						alert("Please enter a valid email address. ");
						emailFld[i].focus();
						return false;
					}
				}
			}
			return true;
		}
		function checkMandatory1127844000002481048() {
			var mndFileds = new Array("Last Name", "Email");
			var fldLangVal = new Array("Name", "Email");
			for (i = 0; i < mndFileds.length; i++) {
				var fieldObj = document.forms["WebToLeads1127844000002481048"][mndFileds[i]];
				if (fieldObj) {
					if (fieldObj.value.replace(/^\s+|\s+$/g, "").length == 0) {
						if (fieldObj.type == "file") {
							alert("Please select a file to upload.");
							fieldObj.focus();
							return false;
						}
						alert(fldLangVal[i] + " cannot be empty.");
						fieldObj.focus();
						return false;
					} else if (fieldObj.nodeName == "SELECT") {
						if (fieldObj.options[fieldObj.selectedIndex].value == "-None-") {
							alert(fldLangVal[i] + " cannot be none.");
							fieldObj.focus();
							return false;
						}
					} else if (fieldObj.type == "checkbox") {
						if (fieldObj.checked == false) {
							alert("Please accept  " + fldLangVal[i]);
							fieldObj.focus();
							return false;
						}
					}
				}
			}
			if (!validateEmail1127844000002481048()) {
				return false;
			}

			// Dynamically set Return URL with UTMs / Params
			var form = document.forms["WebToLeads1127844000002481048"];
			var nameVal = form["Last Name"].value;
			var emailVal = form["Email"].value;
			var returnUrlInput = form.querySelector('input[name="returnURL"]');

			if (returnUrlInput && nameVal && emailVal) {
				try {
					var urlObj = new URL(returnUrlInput.value);
					urlObj.searchParams.set("username", nameVal);
					urlObj.searchParams.set("email", emailVal);
					returnUrlInput.value = urlObj.toString();
				} catch (e) {
					console.error("Invalid returnURL format:", e);
				}
			}

			document.querySelector(".crmWebToEntityForm .formsubmit").setAttribute("disabled", true);
			return true;
		}

		// Simple UTM Hydration Script (Runs on Load)
		(function () {
			const params = new URLSearchParams(window.location.search);

			const mapping = {
				utm_campaign: "LEADCF11",
				utm_source: "LEADCF8",
				utm_medium: "LEADCF9",
				utm_term: "LEADCF7",
				utm_content: "LEADCF10",
				ad_id: "LEADCF13",
				ad_set_id: "LEADCF14",
				ad_name: "LEADCF18",
				ad_platform: "LEADCF12",
				ad_campaign_id: "LEADCF4",
				ad_group_name: "LEADCF5",
				ad_group_id: "LEADCF17",
				ad_campaign_name: "LEADCF6",
			};

			for (const key in mapping) {
				const fieldId = mapping[key];
				const el = document.getElementById(fieldId);
				if (el && params.has(key)) {
					el.value = params.get(key);
				}
			}

			// Landing URL & Referrer
			const landingField = document.getElementById("LEADCF23");
			if (landingField) landingField.value = window.location.href;

			const refField = document.getElementById("LEADCF16");
			if (refField) {
				const referrerUrlParam = params.get("referrer_url") || params.get("referrer") || params.get("ref");
				refField.value = referrerUrlParam || document.referrer || "-";
			}
		})();
	</script>

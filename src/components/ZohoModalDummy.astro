<div id="zoho-modal-dummy-overlay" class="modal-overlay" style="display: none;">
	<div class="modal-container">
		<button id="close-dummy-modal-btn" class="close-btn">&times;</button>

		<div class="modal-content">
			<h2 class="modal-title">The Smarter Way to Learn STEM</h2>
			<p class="modal-subtitle">Try Jove Coach free for 7 days and experience AI-powered clarity for yourself.</p>

			<form id="dummy-modal-form" onsubmit="return false;">
				<div class="form-row">
					<input type="text" name="modalName" placeholder="Name*" required class="input-field" />
					<input type="email" name="modalEmail" placeholder="Email*" required class="input-field" />
				</div>

				<button type="submit" class="submit-btn">Get Started Free</button>

				<div class="benefits">
					<span>• No credit card required • No commitment • Cancel anytime</span>
				</div>
			</form>
		</div>
	</div>
</div>

<script is:inline>
	// Modal Open/Close Logic
	window.openZohoModal = function () {
		// Overwriting global function for testing
		const overlay = document.getElementById("zoho-modal-dummy-overlay");
		if (overlay) {
			overlay.style.display = "flex";
			document.body.style.overflow = "hidden";
		}
	};

	window.closeZohoModal = function () {
		const overlay = document.getElementById("zoho-modal-dummy-overlay");
		if (overlay) {
			overlay.style.display = "none";
			document.body.style.overflow = "auto";
		}
	};

	// Event Listeners
	const closeBtn = document.getElementById("close-dummy-modal-btn");
	if (closeBtn) closeBtn.addEventListener("click", window.closeZohoModal);

	const overlay = document.getElementById("zoho-modal-dummy-overlay");
	if (overlay) {
		overlay.addEventListener("click", e => {
			if (e.target === overlay) window.closeZohoModal();
		});
	}

	// Form Submission
	const modalForm = document.getElementById("dummy-modal-form");
	if (modalForm) {
		modalForm.addEventListener("submit", function (e) {
			e.preventDefault();
			console.log("Dummy Modal Form Submitted");

			const name = modalForm.querySelector('input[name="modalName"]').value;
			const email = modalForm.querySelector('input[name="modalEmail"]').value;

			if (window.submitToZoho) {
				window.submitToZoho({ name, email });
			} else {
				alert("Master form function missing.");
			}
		});
	}
</script>

<style>
	.modal-overlay {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(0, 0, 0, 0.5);
		backdrop-filter: blur(5px);
		z-index: 9999;
		display: flex;
		justify-content: center;
		align-items: center;
		padding: 20px;
	}

	.modal-container {
		position: relative;
		width: 100%;
		max-width: 600px;
		max-height: 90vh;
		overflow-y: auto;
		border-radius: 15px;
		background: #0085f6; /* Simplified for test */
		/* Background image logic can be added later */
	}

	.modal-content {
		padding: 40px 50px;
		color: white;
	}

	.close-btn {
		position: absolute;
		top: 10px;
		right: 15px;
		font-size: 30px;
		color: white;
		background: transparent;
		border: none;
		cursor: pointer;
		z-index: 10000;
	}

	.modal-title {
		font-size: 36px;
		font-weight: 500;
		margin-bottom: 12px;
	}

	.modal-subtitle {
		font-size: 16px;
		margin-bottom: 32px;
		opacity: 0.9;
	}

	.form-row {
		display: flex;
		gap: 1.5rem;
		margin-bottom: 20px;
	}

	.input-field {
		width: 100%;
		padding: 8px 12px;
		border-radius: 8px;
		border: 1px solid rgba(255, 255, 255, 0.3);
		background: rgba(255, 255, 255, 0.95);
	}

	.submit-btn {
		width: 100%;
		background: transparent;
		border: 1px solid rgba(255, 255, 255, 0.4);
		color: white;
		padding: 12px 28px;
		border-radius: 50px;
		font-size: 18px;
		cursor: pointer;
	}

	.submit-btn:hover {
		background: rgba(255, 255, 255, 0.15);
	}

	.benefits {
		font-size: 12px;
		margin-top: 20px;
		opacity: 0.8;
	}

	@media (max-width: 600px) {
		.form-row {
			flex-direction: column;
			gap: 12px;
		}
	}
</style>

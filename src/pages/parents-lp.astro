---
export const prerender = true;
import Navbar from "../components/Navbar.astro";
import Footer from "../components/landingPage_3/Footer.astro";
import HeroSection from "../components/landingPage_3/HeroSectionAlt.astro";
import Layout from "../layouts/Layout.astro";
import JoveGenLpFaqs from "../components/landingPage_3/joveGenLpFaqs.astro";
import ZohoForm from "../components/landingPage_3/zohoForm.astro";
import STEMStruggle from "../components/landingPage_3/STEMStruggle.astro";
import JoVECoachSteps from "../components/landingPage_3/JoVECoachSteps.astro";
import FirstCTASection from "../components/landingPage_3/FirstCTASection.astro";
import SecondCTASection from "../components/landingPage_3/SecondCTASection.astro";
import ConceptsSection from "../components/landingPage_3/ConceptsSection.astro";
import Testimonial from "../components/landingPage_3/testimonial.astro";
import LearnerPersonas from "../components/landingPage_3/LearnerPersonas.astro";
import PricingSection from "../components/landingPage_3/pricingSection.astro";
import ZohoModal from "../components/landingPage_3/ZohoModal.astro";

import HeroSectionVideo from "../assets/lp3_HerosectionVideo.webm";
import HeroSectionImage from "../assets/Hero-Section-Mobile_img.webp";
import HeroSectionPoster from "../assets/parents-mobile-optimized.webp";
import HeroSectionDesktopPoster from "../assets/parents-desktop-final-poster.webp";
import Competition from "../components/ComparisonTable.astro";
import NavLogo from "../assets/NavLogo.svg";
import { getImage } from "astro:assets";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout title="JoVE Coach | STEM Support for Your Child | AI-Powered Learning" description="Affordable, effective STEM help. 2-minute expert videos, AI-powered quizzes, real results. Better than a tutor. Try free for 7 days." robots="noindex, nofollow">
	<link rel="preload" href={HeroSectionVideo} as="video" type="video/webm" slot="head" fetchpriority="high" media="(min-width: 769px)" />
	<link rel="preload" href={HeroSectionImage.src} as="image" slot="head" fetchpriority="high" />
	<link rel="preload" href={NavLogo.src} as="image" type="image/svg+xml" slot="head" fetchpriority="high" />
	<HeroSection videoSrc={HeroSectionVideo} mobileImgSrc={HeroSectionImage} posterSrc={HeroSectionDesktopPoster.src} />
	<STEMStruggle />
	<FirstCTASection />
	<Competition />
	<JoVECoachSteps />
	<SecondCTASection />
	<ConceptsSection />
	<!-- <Testimonial /> -->
	<LearnerPersonas />
	<PricingSection />
	<JoveGenLpFaqs />
	<ZohoForm />
	<ZohoModal />
	<Footer />
</Layout>

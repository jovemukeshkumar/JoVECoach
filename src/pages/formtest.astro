---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/homePage/HeroSectionAltTest.astro";
import ZohoMasterForm from "../components/ZohoMasterForm.astro";
import ZohoDummyForm from "../components/ZohoDummyForm.astro";
import ZohoModalDummy from "../components/ZohoModalDummy.astro";

// Reusing assets for the layout
import HeroSectionVideo from "../assets/LP-Girl-MR.webm";
import HeroSectionImage from "../assets/Hero-Section-Mobile_img (ailearning).webp";
import HeroSectionDesktopPoster from "../assets/ailearning-desktop-final-poster.webp";
import NavLogo from "../assets/NavLogo.svg";
---

<Layout title="Form Test Page" description="Testing centralized form submission" robots="noindex, nofollow">
	<div style="padding: 100px 20px; max-width: 1200px; margin: 0 auto;">
		<h1>Form Abstraction Test</h1>
		<p>This page tests the centralized Zoho submission logic.</p>

		<hr style="margin: 40px 0;" />

		<h2>1. Horizontal Form (Hero Style)</h2>
		<div style="background: #2183ed; padding: 40px; border-radius: 10px; color: white;">
			<ZohoDummyForm layout="horizontal" formIdSuffix="hero-test" />
		</div>

		<hr style="margin: 40px 0;" />

		<h2>2. Vertical Form (CTA Style)</h2>
		<div style="max-width: 400px; border: 1px solid #ccc; padding: 20px; border-radius: 10px;">
			<ZohoDummyForm layout="vertical" formIdSuffix="cta-test" />
		</div>

		<hr style="margin: 40px 0;" />

		<h2>3. Modal Form</h2>
		<button onclick="openZohoModal()" style="padding: 10px 20px; font-size: 18px; cursor: pointer;"> Open Modal </button>

		<ZohoModalDummy />
	</div>

	<!-- The Master Form (Hidden) -->
	<ZohoMasterForm />
</Layout>

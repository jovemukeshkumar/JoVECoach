---
export const prerender = true;
import Navbar from "../components/Navbar.astro";
import Footer from "../components/landingPage_2/Footer.astro";
import HeroSection from "../components/landingPage_2/HeroSectionAlt.astro";
import Layout from "../layouts/Layout.astro";
import JoveGenLpFaqs from "../components/landingPage_2/joveGenLpFaqs.astro";
import ZohoForm from "../components/landingPage_2/zohoForm.astro";
import STEMStruggle from "../components/landingPage_2/STEMStruggle.astro";
import JoVECoachSteps from "../components/landingPage_2/JoVECoachSteps.astro";
import FirstCTASection from "../components/landingPage_2/FirstCTASection.astro";
import SecondCTASection from "../components/landingPage_2/SecondCTASection.astro";
import ConceptsSection from "../components/landingPage_2/ConceptsSection.astro";
// import Testimonial from "../components/landingPage_2/testimonial.astro";
import LearnerPersonas from "../components/landingPage_2/LearnerPersonas.astro";
import PricingSection from "../components/landingPage_2/pricingSection.astro";
import ZohoModal from "../components/landingPage_2/ZohoModal.astro";

import HeroSectionVideo from "../assets/lp2_HeroSectionVideo.webm";
import HeroSectionImage from "../assets/Hero-Section-Mobile_img (homeschool).webp";
import HeroSectionPoster from "../assets/homeschool-mobile-optimized.webp";
import HeroSectionDesktopPoster from "../assets/homeschool-desktop-final-poster.webp";

import NavLogo from "../assets/NavLogo.svg";
import { getImage } from "astro:assets";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout title="JoVE Coach | Homeschool STEM Curriculum | AI-Powered Learning" description="Expert STEM curriculum for homeschool families. 2-minute videos, AI-powered quizzes, structured learning paths. Try free for 7 days." robots="noindex, nofollow">
	<link rel="preload" href={HeroSectionVideo} as="video" type="video/webm" slot="head" fetchpriority="high" media="(min-width: 769px)" />
	<link rel="preload" href={HeroSectionImage.src} as="image" slot="head" fetchpriority="high" />
	<link rel="preload" href={NavLogo.src} as="image" type="image/svg+xml" slot="head" fetchpriority="high" />

	<HeroSection videoSrc={HeroSectionVideo} mobileImgSrc={HeroSectionImage} posterSrc={HeroSectionDesktopPoster.src} />
	<STEMStruggle />
	<FirstCTASection />
	<JoVECoachSteps />
	<SecondCTASection />
	<ConceptsSection />
	<!-- <Testimonial /> -->
	<LearnerPersonas />
	<PricingSection />
	<JoveGenLpFaqs />

	<ZohoForm />
	<ZohoModal />

	<Footer />
</Layout>

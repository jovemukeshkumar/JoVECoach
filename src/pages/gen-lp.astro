---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/homePage/Footer.astro";
import HeroSection from "../components/homePage/HeroSectionAlt.astro";
import Layout from "../layouts/Layout.astro";
import JoveGenLpFaqs from "../components/homePage/joveGenLpFaqs.astro";
import ZohoForm from "../components/zohoForm.astro";
import STEMStruggle from "../components/homePage/STEMStruggle.astro";
import JoVECoachSteps from "../components/homePage/JoVECoachSteps.astro";
import FirstCTASection from "../components/homePage/FirstCTASection.astro";
import SecondCTASection from "../components/homePage/SecondCTASection.astro";
import ConceptsSection from "../components/homePage/ConceptsSection.astro";
import Testimonial from "../components/homePage/testimonial.astro";
import LearnerPersonas from "../components/homePage/LearnerPersonas.astro";
import PricingSection from "../components/homePage/pricingSection.astro";
import ZohoModal from "../components/ZohoModal.astro";

import HeroSectionVideo from "../assets/LP-Girl-MR.webm";
import HeroSectionImage from "../assets/Hero-Section-Mobile_img.png";
import HeroSectionBlueBg from "../assets/HeroSectionBlueBg.png";
import { getImage } from "astro:assets";

const optimizedHeroBg = await getImage({ src: HeroSectionBlueBg, format: "webp" });

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
	<link rel="preload" href={HeroSectionVideo} as="video" type="video/webm" slot="head" fetchpriority="high" media="(min-width: 769px)" />
	<link rel="preload" href={optimizedHeroBg.src} as="image" type="image/webp" slot="head" fetchpriority="high" />
	<link rel="preload" href={HeroSectionImage.src} as="image" media="(max-width: 768px)" slot="head" fetchpriority="high" />

	<HeroSection />
	<STEMStruggle />
	<FirstCTASection />
	<JoVECoachSteps />
	<SecondCTASection />
	<ConceptsSection />
	<Testimonial />
	<LearnerPersonas />
	<PricingSection />
	<JoveGenLpFaqs />

	<ZohoForm />
	<ZohoModal />

	<Footer />
</Layout>
